@page "/history/sessions"
@inject ITrackingSessionQueryService QueryService
@inject Microsoft.Extensions.Options.IOptions<DatabaseBrowserOptions> DatabaseConfiguration

<PageTitle>Sessions · Tracking Database · ADS-B Tracker</PageTitle>

<DatabaseTabs />

<section class="filter-panel">
    <div class="filter-heading">
        <div>
            <h2>Session filters</h2>
            <p>Dates filter the session start date. The date range is not limited to the recent-session dropdown.</p>
        </div>
        <button class="text-button" type="button" @onclick="ClearFiltersAsync">Clear filters</button>
    </div>
    <div class="filter-grid session-filter-grid">
        <label class="filter-grid-full-row">
            <span>Session (last @SessionHistoryDays days)</span>
            <InputSelect @bind-Value="_filter.SessionId">
                <option value="">Any session</option>
                @foreach (var session in _sessions)
                {
                    <option value="@session.Id">@FormatSessionOption(session)</option>
                }
            </InputSelect>
        </label>
        <label><span>From start date</span><InputDate @bind-Value="_filter.FromDate" /></label>
        <label><span>To start date</span><InputDate @bind-Value="_filter.ToDate" /></label>
    </div>
    <div class="filter-actions session-filter-actions">
        <button class="primary-button" type="button" @onclick="SearchAsync" disabled="@_loading">
            @(_loading ? "Searching…" : "Search sessions")
        </button>
    </div>
</section>

@if (_error is not null)
{
    <div class="alert" role="alert"><strong>Session query failed</strong><span>@_error</span></div>
}

<section class="tracker-panel history-panel session-results" aria-busy="@_loading">
    <div class="panel-heading">
        <div><h2>Sessions</h2><p>@ResultDescription</p></div>
        <label class="page-size">
            <span>Rows per page</span>
            <select @bind="_filter.PageSize" @bind:after="ChangePageSizeAsync">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </label>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Started</th>
                    <th>Profile</th>
                    <th>Receiver host</th>
                    <th class="numeric">Receiver port</th>
                    <th class="numeric">Latitude</th>
                    <th class="numeric">Longitude</th>
                    <th class="numeric">Elevation</th>
                    <th class="numeric">Minimum altitude</th>
                    <th class="numeric">Maximum altitude</th>
                    <th class="numeric">Maximum distance</th>
                    <th>Included behaviours</th>
                    <th class="session-notes-heading">Notes</th>
                    <th class="session-analysis-heading">Analysis</th>
                    <th class="session-records-heading">Tracking Records</th>
                </tr>
            </thead>
            <tbody>
                @if (_loading)
                {
                    <tr><td colspan="14" class="table-empty">Loading sessions…</td></tr>
                }
                else if (_result.Items.Count == 0)
                {
                    <tr><td colspan="14" class="table-empty">No sessions match these filters.</td></tr>
                }
                else
                {
                    @foreach (var session in _result.Items)
                    {
                        <tr>
                            <td>@FormatDateTime(session.StartedAtUtc)</td>
                            <td>@Display(session.ProfileName)</td>
                            <td class="mono">@Display(session.Host)</td>
                            <td class="numeric mono">@session.Port</td>
                            <td class="numeric mono">@FormatCoordinate(session.ReceiverLatitude)</td>
                            <td class="numeric mono">@FormatCoordinate(session.ReceiverLongitude)</td>
                            <td class="numeric">@FormatNumber(session.ReceiverElevation, "N0", " ft")</td>
                            <td class="numeric">@FormatNumber(session.MinimumAltitude, "N0", " ft")</td>
                            <td class="numeric">@FormatNumber(session.MaximumAltitude, "N0", " ft")</td>
                            <td class="numeric">@FormatNumber(session.MaximumDistance, "N0", " nm")</td>
                            <td>@DisplayBehaviours(session.IncludedBehaviours)</td>
                            <td class="session-notes-action">
                                <button class="notes-button" type="button"
                                        disabled="@string.IsNullOrWhiteSpace(session.Notes)"
                                        title="@(string.IsNullOrWhiteSpace(session.Notes) ? "No notes recorded" : "View session notes")"
                                        aria-label="@(string.IsNullOrWhiteSpace(session.Notes) ? "No notes recorded" : $"View notes for session started {FormatDateTime(session.StartedAtUtc)}")"
                                        @onclick="() => ShowNotes(session)">
                                    <span aria-hidden="true">📓</span>
                                </button>
                            </td>
                            <td class="session-analysis-action">
                                <button class="analysis-button" type="button"
                                        title="View session analysis"
                                        aria-label="View analysis for session started @FormatDateTime(session.StartedAtUtc)"
                                        disabled="@(_analysisLoading && _analysisSessionId == session.SessionId)"
                                        @onclick="() => ShowAnalysisAsync(session)">
                                    <span aria-hidden="true">📊</span>
                                </button>
                            </td>
                            <td class="session-records-action">
                                <a class="row-link" href="@TrackingRecordsUrl(session)"
                                   aria-label="View tracking records for session started @FormatDateTime(session.StartedAtUtc)">
                                    Records →
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="pagination">
        <button @onclick="PreviousPageAsync" disabled="@(_loading || _result.Page <= 1)">← Previous</button>
        <span>Page <strong>@(_result.TotalPages == 0 ? 0 : _result.Page)</strong> of <strong>@_result.TotalPages</strong></span>
        <button @onclick="NextPageAsync" disabled="@(_loading || _result.Page >= _result.TotalPages)">Next →</button>
    </div>
</section>

@if (_notesSession is not null)
{
    <div class="modal-backdrop" @onclick="CloseNotes">
        <section class="notes-modal" role="dialog" aria-modal="true" aria-labelledby="session-notes-title"
                 tabindex="0" @onclick:stopPropagation @onkeydown="HandleNotesKeyDown">
            <header>
                <div>
                    <p class="eyebrow">Session notes</p>
                    <h2 id="session-notes-title">@FormatDateTime(_notesSession.StartedAtUtc)</h2>
                    <small>@Display(_notesSession.ProfileName)</small>
                </div>
                <button class="icon-button" type="button" aria-label="Close session notes"
                        autofocus @onclick="CloseNotes">×</button>
            </header>
            <div class="notes-modal-content">@_notesSession.Notes</div>
        </section>
    </div>
}

@if (_analysisLoading || _analysis is not null || _analysisError is not null)
{
    <div class="modal-backdrop" @onclick="CloseAnalysis">
        <section class="analysis-modal" role="dialog" aria-modal="true" aria-labelledby="session-analysis-title"
                 tabindex="0" @onclick:stopPropagation @onkeydown="HandleAnalysisKeyDown">
            <header>
                <div>
                    <p class="eyebrow">Observation snapshot</p>
                    <h2 id="session-analysis-title">Session Analysis</h2>
                    @if (_analysis is not null)
                    {
                        <small>@FormatDateTime(_analysis.StartedAtUtc) · @Display(_analysis.ProfileName)</small>
                    }
                </div>
                <button class="icon-button" type="button" aria-label="Close session analysis"
                        autofocus @onclick="CloseAnalysis">×</button>
            </header>

            @if (_analysisLoading)
            {
                <div class="modal-loading">Preparing session analysis…</div>
            }
            else if (_analysisError is not null)
            {
                <div class="alert" role="alert"><strong>Analysis unavailable</strong><span>@_analysisError</span></div>
            }
            else if (_analysis is not null)
            {
                <div class="analysis-modal-content">
                    <section class="summary-section">
                        <h3>Session</h3>
                        <dl class="summary-details">
                            <div><dt>Started</dt><dd>@FormatDateTime(_analysis.StartedAtUtc)</dd></div>
                            <div><dt>Last activity</dt><dd>@FormatOptionalDateTime(_analysis.LastActivity)</dd></div>
                            <div><dt>Observed duration</dt><dd>@FormatDuration(_analysis.ObservedDuration)</dd></div>
                            <div><dt>Tracking profile</dt><dd>@Display(_analysis.ProfileName)</dd></div>
                            <div><dt>Receiver location</dt><dd>@FormatLocation(_analysis)</dd></div>
                            <div><dt>Tracking limits</dt><dd>@FormatLimits(_analysis)</dd></div>
                            <div class="wide"><dt>Included behaviours</dt><dd>@DisplayBehaviours(_analysis.IncludedBehaviours)</dd></div>
                            <div class="wide"><dt>Session notes</dt><dd class="summary-notes">@Display(_analysis.Notes)</dd></div>
                        </dl>
                    </section>

                    <section class="summary-section">
                        <h3>Observation totals</h3>
                        <div class="session-metrics">
                            @foreach (var metric in ObservationMetrics(_analysis))
                            {
                                <article class="session-metric"><span>@metric.Label</span><strong>@metric.Value.ToString("N0")</strong></article>
                            }
                        </div>
                    </section>

                    <section class="summary-section">
                        <h3>Identification</h3>
                        <div class="session-metrics">
                            @foreach (var metric in IdentificationMetrics(_analysis))
                            {
                                <article class="session-metric">
                                    <span>@metric.Label</span><strong>@metric.Value.ToString("N0")</strong>
                                    @if (metric.Detail is not null) { <small>@metric.Detail</small> }
                                </article>
                            }
                        </div>
                    </section>

                    <section class="summary-section">
                        <h3>Session highlights</h3>
                        <div class="highlight-grid">
                            @foreach (var highlight in Highlights(_analysis))
                            {
                                <article class="session-highlight">
                                    <span>@highlight.Label</span><strong>@highlight.Value</strong>
                                    <small>@(highlight.Item is null ? "No recorded value" : DisplayAircraft(highlight.Item))</small>
                                </article>
                            }
                        </div>
                    </section>
                </div>
            }
        </section>
    </div>
}

@code {
#nullable enable
    private ObservationSessionFilter _filter = new();
    private IReadOnlyList<ObservationSessionOptionDto> _sessions = [];
    private PagedResult<ObservationSessionDto> _result = new() { Page = 1, PageSize = 25 };
    private bool _loading;
    private string? _error;
    private ObservationSessionDto? _notesSession;
    private ObservationSessionSummaryDto? _analysis;
    private string? _analysisError;
    private bool _analysisLoading;
    private int? _analysisSessionId;
    private int SessionHistoryDays => DatabaseConfiguration.Value.SessionHistoryDays > 0
        ? DatabaseConfiguration.Value.SessionHistoryDays
        : 7;
    private string ResultDescription => _result.TotalCount == 1
        ? "1 matching session"
        : $"{_result.TotalCount:N0} matching sessions";

    protected override async Task OnInitializedAsync()
    {
        _sessions = await QueryService.ListSessionsAsync();
        await LoadAsync();
    }

    private Task SearchAsync()
    {
        _filter.Page = 1;
        return LoadAsync();
    }

    private Task ClearFiltersAsync()
    {
        var pageSize = _filter.PageSize;
        _filter = new ObservationSessionFilter { PageSize = pageSize };
        return LoadAsync();
    }

    private Task PreviousPageAsync()
    {
        _filter.Page--;
        return LoadAsync();
    }

    private Task NextPageAsync()
    {
        _filter.Page++;
        return LoadAsync();
    }

    private Task ChangePageSizeAsync()
    {
        _filter.Page = 1;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_filter.FromDate.HasValue && _filter.ToDate.HasValue &&
            _filter.FromDate.Value.Date > _filter.ToDate.Value.Date)
        {
            _error = "From start date must be on or before the to start date.";
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            _result = await QueryService.SearchObservationSessionsAsync(_filter);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatSessionOption(ObservationSessionOptionDto session)
        => $"{session.ProfileName} - {DateTime.SpecifyKind(session.StartedAtUtc, DateTimeKind.Utc).ToLocalTime():dd-MMM-yyyy - HH:mm:ss}";

    private static string FormatDateTime(DateTime value)
        => DateTime.SpecifyKind(value, DateTimeKind.Utc).ToLocalTime().ToString("dd MMM yyyy HH:mm:ss");

    private static string FormatCoordinate(double? value)
        => value?.ToString("F6") ?? "—";

    private static string FormatNumber<T>(T? value, string format, string unit) where T : struct, IFormattable
        => value.HasValue ? $"{value.Value.ToString(format, null)}{unit}" : "—";

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string DisplayBehaviours(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value.Replace(",", ", ");

    private static string TrackingRecordsUrl(ObservationSessionDto session)
        => $"history?sessionId={session.SessionId}";

    private void ShowNotes(ObservationSessionDto session)
    {
        if (!string.IsNullOrWhiteSpace(session.Notes)) _notesSession = session;
    }

    private void CloseNotes() => _notesSession = null;

    private void HandleNotesKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseNotes();
    }

    private async Task ShowAnalysisAsync(ObservationSessionDto session)
    {
        var requestedSessionId = session.SessionId;
        _analysisSessionId = requestedSessionId;
        _analysis = null;
        _analysisError = null;
        _analysisLoading = true;
        try
        {
            var analysis = await QueryService.GetObservationSessionSummaryAsync(requestedSessionId);
            if (_analysisSessionId != requestedSessionId) return;
            _analysis = analysis;
            if (_analysis is null) _analysisError = "The selected session could not be found.";
        }
        catch (Exception exception)
        {
            if (_analysisSessionId != requestedSessionId) return;
            _analysisError = exception.Message;
        }
        finally
        {
            if (_analysisSessionId == requestedSessionId) _analysisLoading = false;
        }
    }

    private void CloseAnalysis()
    {
        _analysis = null;
        _analysisError = null;
        _analysisLoading = false;
        _analysisSessionId = null;
    }

    private void HandleAnalysisKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseAnalysis();
    }

    private static IEnumerable<(string Label, int Value)> ObservationMetrics(ObservationSessionSummaryDto summary) =>
    [
        ("Observation records", summary.ObservationRecords),
        ("Distinct aircraft", summary.DistinctAircraft),
        ("Distinct callsigns", summary.DistinctCallsigns),
        ("Aircraft with positions", summary.AircraftWithPositionHistory),
        ("Position records", summary.PositionRecords)
    ];

    private static IEnumerable<(string Label, int Value, string? Detail)> IdentificationMetrics(ObservationSessionSummaryDto summary) =>
    [
        ("Aircraft identified", summary.IdentifiedAircraft, $"{summary.AircraftResolutionPercentage:N1}% resolved"),
        ("Flights resolved", summary.ResolvedFlights, $"{summary.FlightResolutionPercentage:N1}% resolved"),
        ("Unidentified aircraft", summary.UnidentifiedAircraft, null)
    ];

    private static IEnumerable<(string Label, ObservationHighlightDto? Item, string Value)> Highlights(ObservationSessionSummaryDto summary) =>
    [
        ("Lowest altitude", summary.LowestAltitude, FormatHighlightAltitude(summary.LowestAltitude)),
        ("Highest altitude", summary.HighestAltitude, FormatHighlightAltitude(summary.HighestAltitude)),
        ("Furthest aircraft", summary.FurthestAircraft, FormatHighlightDistance(summary.FurthestAircraft)),
        ("Longest observed", summary.LongestObservedAircraft, FormatHighlightDuration(summary.LongestObservedAircraft))
    ];

    private static string FormatOptionalDateTime(DateTime? value)
        => value?.ToString("dd MMM yyyy HH:mm:ss") ?? "No activity recorded";

    private static string FormatDuration(TimeSpan value)
        => value.TotalHours >= 1
            ? $"{(int)value.TotalHours}h {value.Minutes}m {value.Seconds}s"
            : value.TotalMinutes >= 1 ? $"{value.Minutes}m {value.Seconds}s" : $"{Math.Max(0, value.Seconds)}s";

    private static string FormatLocation(ObservationSessionSummaryDto summary)
        => summary.ReceiverLatitude.HasValue && summary.ReceiverLongitude.HasValue
            ? $"{summary.ReceiverLatitude:F6}, {summary.ReceiverLongitude:F6}" +
              (summary.ReceiverElevation.HasValue ? $" · {summary.ReceiverElevation:N0} ft" : string.Empty)
            : "Not configured";

    private static string FormatLimits(ObservationSessionSummaryDto summary)
    {
        var altitude = summary.MinimumAltitudeLimit.HasValue || summary.MaximumAltitudeLimit.HasValue
            ? $"{summary.MinimumAltitudeLimit?.ToString("N0") ?? "Any"}–{summary.MaximumAltitudeLimit?.ToString("N0") ?? "Any"} ft"
            : "Any altitude";
        var distance = summary.MaximumDistanceLimit.HasValue
            ? $"within {summary.MaximumDistanceLimit:N0} nm"
            : "any distance";
        return $"{altitude} · {distance}";
    }

    private static string FormatHighlightAltitude(ObservationHighlightDto? item)
        => item?.Altitude is decimal value ? $"{value:N0} ft" : "—";

    private static string FormatHighlightDistance(ObservationHighlightDto? item)
        => item?.Distance is double value ? $"{value:N1} nm" : "—";

    private static string FormatHighlightDuration(ObservationHighlightDto? item)
        => item?.Duration is TimeSpan value ? FormatDuration(value) : "—";

    private static string DisplayAircraft(ObservationHighlightDto item)
        => string.IsNullOrWhiteSpace(item.Callsign) ? item.Address : $"{item.Callsign} · {item.Address}";
}
