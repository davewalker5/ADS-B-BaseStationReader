@page "/history/excluded-addresses"
@inject IExcludedAddressService ExcludedAddressService

<PageTitle>Excluded Addresses · Database · ADS-B Tracker</PageTitle>

<DatabaseTabs />

<section class="filter-panel">
    <div class="filter-heading">
        <div><h2>Address filter</h2><p>Search by a full or partial ICAO aircraft address.</p></div>
        <button class="text-button" type="button" @onclick="ClearFilterAsync" disabled="@_loading">Clear filter</button>
    </div>
    <form @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <div class="filter-grid exclusion-filter-grid">
            <label><span>ICAO address</span><input @bind="_address" maxlength="6" placeholder="e.g. 406B90" autocomplete="off" /></label>
        </div>
        <div class="filter-actions">
            <button class="primary-button" type="submit" disabled="@_loading">@(_loading ? "Searching…" : "Search addresses")</button>
            <button class="danger-button" type="button" @onclick="ShowPurge" disabled="@(_loading || _purging)">Purge</button>
        </div>
    </form>
</section>

@if (_error is not null)
{
    <div class="alert" role="alert"><strong>Address query failed</strong><span>@_error</span></div>
}

@if (_purgeMessage is not null)
{
    <div class="alert success" role="status"><strong>Purge complete</strong><span>@_purgeMessage</span></div>
}

<section class="tracker-panel history-panel" aria-busy="@_loading">
    <div class="panel-heading">
        <div><h2>Excluded addresses</h2><p>@ResultDescription</p></div>
        <button class="primary-button" type="button" @onclick="ShowAdd" disabled="@(_loading || _adding)">Add</button>
    </div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>ICAO address</th><th class="exclusion-delete-heading">Remove</th></tr></thead>
            <tbody>
                @if (_loading)
                {
                    <tr><td colspan="2" class="table-empty">Loading excluded addresses…</td></tr>
                }
                else if (_results.Count == 0)
                {
                    <tr><td colspan="2" class="table-empty">No excluded addresses match this filter.</td></tr>
                }
                else
                {
                    @foreach (var exclusion in _results)
                    {
                        <tr>
                            <td class="mono">@exclusion.Address</td>
                            <td class="exclusion-delete-action">
                                <button class="session-delete-button" type="button" title="Remove excluded address"
                                        aria-label="Remove excluded address @exclusion.Address" disabled="@_deleting"
                                        @onclick="() => ConfirmDelete(exclusion)"><span aria-hidden="true">🗑️</span></button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@if (_showingAdd)
{
    <div class="modal-backdrop" @onclick="CloseAdd">
        <section class="confirmation-modal" role="dialog" aria-modal="true" aria-labelledby="add-excluded-address-title"
                 tabindex="0" @onclick:stopPropagation @onkeydown="HandleAddKeyDown">
            <header>
                <div><p class="eyebrow">New exclusion</p><h2 id="add-excluded-address-title">Add excluded address</h2></div>
                <button class="icon-button" type="button" aria-label="Close add address dialog"
                        @onclick="CloseAdd" disabled="@_adding">×</button>
            </header>
            <form @onsubmit="SaveAddAsync" @onsubmit:preventDefault>
                <label class="modal-field">
                    <span>ICAO address</span>
                    <input @bind="_newAddress" @bind:event="oninput" maxlength="6" placeholder="e.g. 406B90" autocomplete="off" autofocus />
                </label>
                @if (_addError is not null)
                {
                    <div class="alert" role="alert"><strong>Address save failed</strong><span>@_addError</span></div>
                }
                <div class="confirmation-actions">
                    <button class="secondary-button" type="button" @onclick="CloseAdd" disabled="@_adding">Cancel</button>
                    <button class="primary-button" type="submit" disabled="@(_adding || !CanSaveAddress)">@(_adding ? "Saving…" : "Save")</button>
                </div>
            </form>
        </section>
    </div>
}

@if (_deleteExclusion is not null)
{
    <div class="modal-backdrop" @onclick="CloseDelete">
        <section class="confirmation-modal" role="dialog" aria-modal="true" aria-labelledby="delete-excluded-address-title"
                 tabindex="0" @onclick:stopPropagation @onkeydown="HandleDeleteKeyDown">
            <header>
                <div><p class="eyebrow">Remove exclusion</p><h2 id="delete-excluded-address-title">Remove excluded address?</h2></div>
                <button class="icon-button" type="button" aria-label="Close remove confirmation"
                        autofocus @onclick="CloseDelete" disabled="@_deleting">×</button>
            </header>
            <p>Aircraft address <strong>@_deleteExclusion.Address</strong> will no longer be excluded from tracking.</p>
            @if (_deleteError is not null)
            {
                <div class="alert" role="alert"><strong>Address removal failed</strong><span>@_deleteError</span></div>
            }
            <div class="confirmation-actions">
                <button class="secondary-button" type="button" @onclick="CloseDelete" disabled="@_deleting">Cancel</button>
                <button class="danger-button" type="button" @onclick="DeleteAsync" disabled="@_deleting">@(_deleting ? "Removing…" : "Remove address")</button>
            </div>
        </section>
    </div>
}


@if (_showingPurge)
{
    <div class="modal-backdrop" @onclick="ClosePurge">
        <section class="confirmation-modal" role="dialog" aria-modal="true" aria-labelledby="purge-excluded-addresses-title"
                 tabindex="0" @onclick:stopPropagation @onkeydown="HandlePurgeKeyDown">
            <header>
                <div><p class="eyebrow">Purge tracking data</p><h2 id="purge-excluded-addresses-title">Delete excluded-aircraft tracking data?</h2></div>
                <button class="icon-button" type="button" aria-label="Close purge confirmation"
                        autofocus @onclick="ClosePurge" disabled="@_purging">×</button>
            </header>
            <p>This will permanently delete all tracking records and associated position records for every aircraft address in the excluded-address table. The excluded addresses will be retained.</p>
            @if (_purgeError is not null)
            {
                <div class="alert" role="alert"><strong>Purge failed</strong><span>@_purgeError</span></div>
            }
            <div class="confirmation-actions">
                <button class="secondary-button" type="button" @onclick="ClosePurge" disabled="@_purging">Cancel</button>
                <button class="danger-button" type="button" @onclick="PurgeAsync" disabled="@_purging">@(_purging ? "Purging…" : "Purge tracking data")</button>
            </div>
        </section>
    </div>
}

@code {
#nullable enable
    private IReadOnlyList<ExcludedAddress> _results = [];
    private string _address = string.Empty;
    private string? _error;
    private string? _deleteError;
    private bool _loading;
    private bool _deleting;
    private bool _adding;
    private bool _showingAdd;
    private bool _showingPurge;
    private bool _purging;
    private string? _purgeError;
    private string? _purgeMessage;
    private string _newAddress = string.Empty;
    private string? _addError;
    private ExcludedAddress? _deleteExclusion;
    private string ResultDescription => _results.Count == 1 ? "1 matching address" : $"{_results.Count:N0} matching addresses";
    private bool CanSaveAddress => _newAddress.Trim().Length == 6 && _newAddress.Trim().All(Uri.IsHexDigit);

    /// <summary>
    /// Loads all excluded addresses when the component is initialised.
    /// </summary>
    protected override async Task OnInitializedAsync()
        => await LoadAsync();

    /// <summary>
    /// Applies the current address filter.
    /// </summary>
    private async Task SearchAsync()
    {
        _address = _address.Trim().ToUpperInvariant();
        await LoadAsync();
    }

    /// <summary>
    /// Clears the address filter and reloads all exclusions.
    /// </summary>
    private async Task ClearFilterAsync()
    {
        _address = string.Empty;
        await LoadAsync();
    }

    /// <summary>
    /// Loads exclusions matching the current filter.
    /// </summary>
    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _results = await ExcludedAddressService.SearchAsync(_address);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Opens an empty add-address dialog.
    /// </summary>
    private void ShowAdd()
    {
        _newAddress = string.Empty;
        _addError = null;
        _showingAdd = true;
    }

    /// <summary>
    /// Closes the add-address dialog when saving is not active.
    /// </summary>
    private void CloseAdd()
    {
        if (!_adding)
        {
            _showingAdd = false;
            _addError = null;
        }
    }

    /// <summary>
    /// Persists the entered excluded address and refreshes the table.
    /// </summary>
    private async Task SaveAddAsync()
    {
        if (!CanSaveAddress)
        {
            return;
        }

        _adding = true;
        _addError = null;
        try
        {
            await ExcludedAddressService.AddAsync(_newAddress);
            _showingAdd = false;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _addError = exception.Message;
        }
        finally
        {
            _adding = false;
        }
    }

    /// <summary>
    /// Opens the removal confirmation for an excluded address.
    /// </summary>
    /// <param name="exclusion">The exclusion selected for removal.</param>
    private void ConfirmDelete(ExcludedAddress exclusion)
    {
        _deleteError = null;
        _deleteExclusion = exclusion;
    }

    /// <summary>
    /// Opens the tracking-data purge confirmation.
    /// </summary>
    private void ShowPurge()
    {
        _purgeError = null;
        _purgeMessage = null;
        _showingPurge = true;
    }

    /// <summary>
    /// Closes the purge confirmation when a purge is not active.
    /// </summary>
    private void ClosePurge()
    {
        if (!_purging)
        {
            _showingPurge = false;
            _purgeError = null;
        }
    }

    /// <summary>
    /// Purges tracking data belonging to excluded aircraft addresses.
    /// </summary>
    private async Task PurgeAsync()
    {
        _purging = true;
        _purgeError = null;
        try
        {
            var deletedAircraft = await ExcludedAddressService.PurgeTrackingDataAsync();
            _showingPurge = false;
            _purgeMessage = deletedAircraft == 1
                ? "1 tracking record and its associated positions were deleted."
                : $"{deletedAircraft:N0} tracking records and their associated positions were deleted.";
        }
        catch (Exception exception)
        {
            _purgeError = exception.Message;
        }
        finally
        {
            _purging = false;
        }
    }

    /// <summary>
    /// Closes the removal confirmation when deletion is not active.
    /// </summary>
    private void CloseDelete()
    {
        if (!_deleting)
        {
            _deleteExclusion = null;
            _deleteError = null;
        }
    }

    /// <summary>
    /// Removes the selected address and refreshes the table.
    /// </summary>
    private async Task DeleteAsync()
    {
        if (_deleteExclusion is null)
        {
            return;
        }

        _deleting = true;
        _deleteError = null;
        try
        {
            await ExcludedAddressService.DeleteAsync(_deleteExclusion.Address);
            _deleteExclusion = null;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _deleteError = exception.Message;
        }
        finally
        {
            _deleting = false;
        }
    }

    /// <summary>
    /// Closes the removal confirmation when Escape is pressed.
    /// </summary>
    /// <param name="args">The keyboard event details.</param>
    private void HandleDeleteKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseDelete();
        }
    }

    /// <summary>
    /// Closes the add-address dialog when Escape is pressed.
    /// </summary>
    /// <param name="args">The keyboard event details.</param>
    private void HandleAddKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseAdd();
        }
    }

    /// <summary>
    /// Closes the purge confirmation when Escape is pressed.
    /// </summary>
    private void HandlePurgeKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            ClosePurge();
        }
    }
}
