@page "/import"
@inject IDataImportService ImportService
@inject IProvenanceService ProvenanceService
@inject IAircraftReferenceService AircraftService
@inject ITrackingControlService TrackingControl
@inject IJSRuntime JS
@using BaseStationReader.Entities.Api

<PageTitle>Reference Data · ADS-B Tracker</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">Lookup data</p>
        <h1>Reference Data</h1>
        <p class="lede">Import reference datasets and record where that data came from.</p>
    </div>
</section>

<div class="reference-tabs" role="tablist" aria-label="Reference data">
    <button type="button" role="tab" aria-selected="@(_activeTab == ReferenceTab.Import)"
            class="@(_activeTab == ReferenceTab.Import ? "active" : null)" @onclick="() => SelectTabAsync(ReferenceTab.Import)">Import</button>
    <button type="button" role="tab" aria-selected="@(_activeTab == ReferenceTab.Provenance)"
            class="@(_activeTab == ReferenceTab.Provenance ? "active" : null)" @onclick="() => SelectTabAsync(ReferenceTab.Provenance)">Provenance</button>
    <button type="button" role="tab" aria-selected="@(_activeTab == ReferenceTab.Aircraft)"
            class="@(_activeTab == ReferenceTab.Aircraft ? "active" : null)" @onclick="() => SelectTabAsync(ReferenceTab.Aircraft)">Aircraft</button>
    <button type="button" role="tab" aria-selected="@(_activeTab == ReferenceTab.Airlines)"
            class="@(_activeTab == ReferenceTab.Airlines ? "active" : null)" @onclick="() => SelectTabAsync(ReferenceTab.Airlines)">Airlines</button>
    <button type="button" role="tab" aria-selected="@(_activeTab == ReferenceTab.Airports)"
            class="@(_activeTab == ReferenceTab.Airports ? "active" : null)" @onclick="() => SelectTabAsync(ReferenceTab.Airports)">Airports</button>
    <button type="button" role="tab" aria-selected="@(_activeTab == ReferenceTab.Flights)"
            class="@(_activeTab == ReferenceTab.Flights ? "active" : null)" @onclick="() => SelectTabAsync(ReferenceTab.Flights)">Flights</button>
    <button type="button" role="tab" aria-selected="@(_activeTab == ReferenceTab.Manufacturers)"
            class="@(_activeTab == ReferenceTab.Manufacturers ? "active" : null)" @onclick="() => SelectTabAsync(ReferenceTab.Manufacturers)">Manufacturers</button>
    <button type="button" role="tab" aria-selected="@(_activeTab == ReferenceTab.Models)"
            class="@(_activeTab == ReferenceTab.Models ? "active" : null)" @onclick="() => SelectTabAsync(ReferenceTab.Models)">Models</button>
</div>

@if (_activeTab == ReferenceTab.Import)
{
    <section class="import-warning" aria-labelledby="import-licence-warning">
        <h3 id="import-licence-warning">Use appropriately licensed data only</h3>
        <p>Only import data that you are permitted to store and reuse. Check the licence, terms of service, copyright, and any other conditions that apply to the source before importing data into ADS-B Tracker.</p>
        <h3>Record the provenance of imported data</h3>
        <p>Before importing data, create a provenance record for its source using the <strong>Provenance</strong> tab.</p>
        <p>Each row in the import file must reference the appropriate provenance record using it's "Source Reference". This records where the imported data came from, the dataset or version used, and the licence under which it is being used.</p>
        <p>Where an import contains data from more than one source, assign the appropriate provenance indicator to each row before importing.</p>
    </section>

    <section class="import-panel">
        <div class="import-type-grid" role="radiogroup" aria-label="Import type">
            @foreach (var option in ImportOptions)
            {
                <label class="import-type-card @(option.Type == _importType ? "selected" : null)">
                    <input type="radio" name="import-type" value="@option.Type"
                           checked="@(option.Type == _importType)" @onchange="() => SelectType(option.Type)" />
                    <span><strong>@option.Name</strong><small>@option.Description</small></span>
                </label>
            }
        </div>

        <div class="import-upload">
            <label for="csv-file">
                <span>CSV file</span>
                <InputFile id="csv-file" OnChange="SelectFile" accept=".csv,text/csv" disabled="@_importing" />
            </label>
            <div class="import-file-summary">
                @if (_file is null) { <span>No file selected</span> }
                else { <strong>@_file.Name</strong><span>@FormatSize(_file.Size)</span> }
            </div>
            <button class="primary-button" type="button" @onclick="ImportAsync" disabled="@(!CanImport)">
                @(_importing ? "Importing…" : $"Import {SelectedOption.Name.ToLowerInvariant()}")
            </button>
        </div>
        <p class="import-note">Imports add or update records using the lookup tool's existing rules. The maximum upload size is 50 MB.</p>
    </section>
}
else if (_activeTab == ReferenceTab.Provenance)
{
    <section class="provenance-panel">
        <div class="table-wrap provenance-table-wrap">
            <table>
                <thead><tr><th>Reference</th><th>Source</th><th>Dataset</th><th>Version</th><th>Licence</th><th aria-label="Actions"></th></tr></thead>
                <tbody>
                    @if (_loadingProvenance)
                    {
                        <tr><td colspan="6" class="table-empty">Loading provenance records…</td></tr>
                    }
                    else if (_provenance.Count == 0)
                    {
                        <tr><td colspan="6" class="table-empty">No provenance records have been added.</td></tr>
                    }
                    else
                    {
                        @foreach (var record in _provenance)
                        {
                            <tr class="@(record.Id == _editModel.Id ? "selected" : null)" tabindex="0"
                                @onclick="() => Edit(record)" @onkeydown="args => SelectRowFromKeyboard(args, record)">
                                <td>@record.SourceRef</td>
                                <td><strong>@record.Source</strong><span class="table-subtitle">@record.SourceUrl</span></td>
                                <td>@record.SourceDataset</td><td>@record.SourceVersion</td><td>@record.Licence</td>
                                <td class="provenance-actions" @onclick:stopPropagation="true">
                                    <button type="button" class="delete-button" @onclick="() => DeleteAsync(record)" disabled="@_saving">Delete</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="provenance-editor">
            <div><h2>@(_editModel.Id == 0 ? "Add provenance" : "Edit provenance")</h2><p>@(_editModel.Id == 0 ? "Create a provenance record." : $"Editing {_editModel.SourceRef}.")</p></div>
            <EditForm Model="_editModel" OnValidSubmit="SaveAsync" FormName="provenance-editor">
                <DataAnnotationsValidator />
                <div class="provenance-fields">
                    <label><span>Source reference</span><InputText @bind-Value="_editModel.SourceRef" /></label>
                    <label><span>Source</span><InputText @bind-Value="_editModel.Source" /></label>
                    <label class="wide"><span>Source URL</span><InputText @bind-Value="_editModel.SourceUrl" /></label>
                    <label><span>Dataset</span><InputText @bind-Value="_editModel.SourceDataset" /></label>
                    <label><span>Version</span><InputText @bind-Value="_editModel.SourceVersion" /></label>
                    <label><span>Licence</span><InputText @bind-Value="_editModel.Licence" /></label>
                </div>
                <ValidationSummary />
                <div class="provenance-editor-actions">
                    <button class="primary-button" type="submit" disabled="@_saving">@(_saving ? "Saving…" : "Save")</button>
                    <button class="secondary-button" type="button" @onclick="Clear" disabled="@_saving">Clear</button>
                </div>
            </EditForm>
        </div>
    </section>
}
else if (_activeTab == ReferenceTab.Aircraft)
{
    <section class="aircraft-panel">
        <div class="aircraft-filter">
            <label><span>ICAO address</span><InputText @bind-Value="_aircraftAddress" /></label>
            <label><span>Registration</span><InputText @bind-Value="_aircraftRegistration" /></label>
            <button class="primary-button" type="button" @onclick="FindAircraftAsync" disabled="@_loadingAircraft">
                @(_loadingAircraft ? "Searching…" : "Find aircraft")
            </button>
        </div>

        <div class="table-wrap provenance-table-wrap aircraft-table-wrap">
            <table>
                <thead><tr><th>ICAO address</th><th>Registration</th><th>Model</th><th>Manufactured</th><th>Age</th><th>Provenance</th><th>Delete</th></tr></thead>
                <tbody>
                    @if (_loadingAircraft)
                    {
                        <tr><td colspan="7" class="table-empty">Searching aircraft…</td></tr>
                    }
                    else if (!_aircraftSearchPerformed)
                    {
                        <tr><td colspan="7" class="table-empty">Enter an ICAO address or registration to find aircraft.</td></tr>
                    }
                    else if (_aircraft.Count == 0)
                    {
                        <tr><td colspan="7" class="table-empty">No aircraft matched those filters.</td></tr>
                    }
                    else
                    {
                        @foreach (var record in _aircraft)
                        {
                            <tr class="@(record.Id == _aircraftEditModel.Id ? "selected" : null)" tabindex="0"
                                @onclick="() => EditAircraft(record)" @onkeydown="args => SelectAircraftFromKeyboard(args, record)">
                                <td><strong>@record.Address</strong></td>
                                <td>@record.Registration</td>
                                <td>@record.Model?.Name <span class="table-subtitle">@record.Model?.ICAO</span></td>
                                <td>@record.Manufactured</td><td>@record.Age</td>
                                <td>@record.Provenance?.SourceRef</td>
                                <td class="session-delete-action" @onclick:stopPropagation="true">
                                    <button class="session-delete-button" type="button"
                                            disabled="@(TrackingControl.IsTracking || _saving)"
                                            title="@(TrackingControl.IsTracking ? "Aircraft deletion is unavailable while a session is active" : "Delete aircraft")"
                                            aria-label="Delete aircraft @record.Address"
                                            @onclick="() => ConfirmDeleteAircraft(record)">
                                        <span aria-hidden="true">🗑️</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="provenance-editor">
            <div>
                <h2>@(_aircraftEditModel.Id == 0 ? "Add aircraft" : "Edit aircraft")</h2>
                <p>@(_aircraftEditModel.Id == 0 ? "Create a new aircraft record." : $"Editing {_aircraftEditModel.Address}.")</p>
            </div>
            <EditForm Model="_aircraftEditModel" OnValidSubmit="SaveAircraftAsync" FormName="aircraft-editor">
                <DataAnnotationsValidator />
                <div class="provenance-fields">
                    <label><span>ICAO address</span><InputText @bind-Value="_aircraftEditModel.Address" disabled="@(!CanEditAircraft)" /></label>
                    <label><span>Registration</span><InputText @bind-Value="_aircraftEditModel.Registration" disabled="@(!CanEditAircraft)" /></label>
                    <label><span>Manufactured</span><InputNumber @bind-Value="_aircraftEditModel.Manufactured" disabled="@(!CanEditAircraft)" /></label>
                    <label><span>Age</span><InputNumber @bind-Value="_aircraftEditModel.Age" disabled="@(!CanEditAircraft)" /></label>
                    <label>
                        <span>Manufacturer</span>
                        <select value="@_selectedManufacturerId" @onchange="SelectManufacturer" disabled="@(!CanEditAircraft)">
                            <option value="0">Select a manufacturer</option>
                            @foreach (var manufacturer in Manufacturers)
                            {
                                <option value="@manufacturer.Id">@manufacturer.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>Model</span>
                        <InputSelect @bind-Value="_aircraftEditModel.ModelId" disabled="@(!CanEditAircraft)">
                            <option value="0">Select a model</option>
                            @foreach (var model in FilteredModels)
                            {
                                <option value="@model.Id">@ModelLabel(model)</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        <span>Provenance</span>
                        <InputSelect @bind-Value="_aircraftEditModel.ProvenanceId" disabled="@(!CanEditAircraft)">
                            <option value="0">Select provenance</option>
                            @foreach (var provenance in _provenance)
                            {
                                <option value="@provenance.Id">@provenance.SourceRef - @provenance.Source</option>
                            }
                        </InputSelect>
                    </label>
                </div>
                <ValidationSummary />
                @if (TrackingControl.IsTracking)
                {
                    <p class="editor-read-only">Aircraft cannot be changed while a live tracking session is active.</p>
                }
                <div class="provenance-editor-actions">
                    <button class="primary-button" type="submit" disabled="@(!CanEditAircraft)">Save aircraft</button>
                    <button class="secondary-button" type="button" @onclick="ClearAircraftSelection" disabled="@_saving">Clear</button>
                </div>
            </EditForm>
        </div>
    </section>
}
else if (_activeTab == ReferenceTab.Airlines)
{
    <AirlineEditor />
}
else if (_activeTab == ReferenceTab.Airports)
{
    <AirportEditor />
}
else if (_activeTab == ReferenceTab.Flights)
{
    <FlightEditor />
}
else if (_activeTab == ReferenceTab.Manufacturers)
{
    <ManufacturerEditor />
}
else
{
    <ModelEditor />
}

@if (_deleteAircraft is not null)
{
    <div class="modal-backdrop" @onclick="CloseDeleteAircraft">
        <section class="confirmation-modal" role="dialog" aria-modal="true" aria-labelledby="delete-aircraft-title"
                 tabindex="0" @onclick:stopPropagation @onkeydown="HandleDeleteAircraftKeyDown">
            <header>
                <div>
                    <p class="eyebrow">Permanent deletion</p>
                    <h2 id="delete-aircraft-title">Delete aircraft?</h2>
                </div>
                <button class="icon-button" type="button" aria-label="Close delete confirmation"
                        autofocus @onclick="CloseDeleteAircraft" disabled="@_saving">×</button>
            </header>
            <p>This will permanently delete aircraft <strong>@_deleteAircraft.Address</strong>
                (@_deleteAircraft.Registration).</p>
            @if (_aircraftDeleteError is not null)
            {
                <div class="alert" role="alert"><strong>Aircraft deletion failed</strong><span>@_aircraftDeleteError</span></div>
            }
            <div class="confirmation-actions">
                <button class="secondary-button" type="button" @onclick="CloseDeleteAircraft" disabled="@_saving">Cancel</button>
                <button class="danger-button" type="button" @onclick="DeleteAircraftAsync"
                        disabled="@(_saving || TrackingControl.IsTracking)">
                    @(_saving ? "Deleting…" : "Delete aircraft")
                </button>
            </div>
        </section>
    </div>
}

@if (_error is not null) { <div class="alert" role="alert"><strong>Operation failed</strong><span>@_error</span></div> }
@if (_success is not null) { <div class="import-success" role="status"><strong>Complete</strong><span>@_success</span></div> }

@code {
#nullable enable
    private const long MaximumFileSize = 50L * 1024 * 1024;
    private static readonly ImportOption[] ImportOptions =
    [
        new(DataImportType.Aircraft, "Aircraft", "Aircraft definitions, registrations and model codes"),
        new(DataImportType.Airlines, "Airlines", "Airline names with IATA and ICAO codes"),
        new(DataImportType.Airports, "Airports", "Airport names, locations, distances and IATA/ICAO codes"),
        new(DataImportType.Flights, "Flights", "Callsigns with optional routes and airlines"),
        new(DataImportType.Manufacturers, "Manufacturers", "Aircraft manufacturer definitions"),
        new(DataImportType.Models, "Models", "Aircraft model definitions and manufacturer links")
    ];

    private ReferenceTab _activeTab;
    private DataImportType _importType = DataImportType.Aircraft;
    private IBrowserFile? _file;
    private bool _importing;
    private bool _loadingProvenance;
    private bool _saving;
    private bool _loadingAircraft;
    private bool _aircraftSearchPerformed;
    private string? _error;
    private string? _success;
    private List<Provenance> _provenance = [];
    private List<Aircraft> _aircraft = [];
    private List<Model> _models = [];
    private Provenance _editModel = new();
    private Aircraft _aircraftEditModel = new();
    private Aircraft? _deleteAircraft;
    private string? _aircraftDeleteError;
    private string _aircraftAddress = "";
    private string _aircraftRegistration = "";
    private int _selectedManufacturerId;
    private bool CanEditAircraft => !_saving && !TrackingControl.IsTracking;
    private IEnumerable<Manufacturer> Manufacturers => _models
        .Select(x => x.Manufacturer)
        .Where(x => x is not null)
        .GroupBy(x => x.Id)
        .Select(x => x.First())
        .OrderBy(x => x.Name);
    private IEnumerable<Model> FilteredModels => _selectedManufacturerId == 0
        ? []
        : _models.Where(x => x.ManufacturerId == _selectedManufacturerId).OrderBy(x => x.Name);
    private bool CanImport => !_importing && _file is not null && _file.Size <= MaximumFileSize &&
        string.Equals(Path.GetExtension(_file.Name), ".csv", StringComparison.OrdinalIgnoreCase);
    private ImportOption SelectedOption => ImportOptions.First(option => option.Type == _importType);

    private async Task SelectTabAsync(ReferenceTab tab)
    {
        _activeTab = tab;
        _error = null;
        _success = null;
        if (tab == ReferenceTab.Provenance && _provenance.Count == 0)
        {
            await LoadProvenanceAsync();
        }
        if (tab == ReferenceTab.Aircraft)
        {
            if (_provenance.Count == 0)
            {
                await LoadProvenanceAsync();
            }
            if (_models.Count == 0)
            {
                _models = (await AircraftService.ListModelsAsync()).OrderBy(x => x.Name).ToList();
            }
        }
    }

    private async Task LoadProvenanceAsync()
    {
        _loadingProvenance = true;
        try { _provenance = (await ProvenanceService.ListAsync()).OrderBy(x => x.SourceRef).ToList(); }
        catch (Exception exception) { _error = exception.Message; }
        finally { _loadingProvenance = false; }
    }

    private void Edit(Provenance record) => _editModel = Copy(record);
    private void SelectRowFromKeyboard(KeyboardEventArgs args, Provenance record)
    {
        if (args.Key is "Enter" or " ")
        {
            Edit(record);
        }
    }

    private void Clear()
    {
        _editModel = new();
        _error = null;
        _success = null;
    }

    private async Task SaveAsync()
    {
        _saving = true; _error = null; _success = null;
        try
        {
            var isNew = _editModel.Id == 0;
            await ProvenanceService.SaveAsync(_editModel);
            await LoadProvenanceAsync();
            Clear();
            _success = isNew ? "Provenance record added." : "Provenance record updated.";
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(Provenance record)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete provenance record '{record.SourceRef}'?"))
        {
            return;
        }
        _saving = true; _error = null; _success = null;
        try
        {
            await ProvenanceService.DeleteAsync(record.Id);
            if (_editModel.Id == record.Id)
            {
                Clear();
            }
            await LoadProvenanceAsync();
            _success = "Provenance record deleted.";
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _saving = false; }
    }

    private async Task FindAircraftAsync()
    {
        if (string.IsNullOrWhiteSpace(_aircraftAddress) &&
            string.IsNullOrWhiteSpace(_aircraftRegistration))
        {
            _aircraft = [];
            _aircraftSearchPerformed = false;
            _error = "Enter an ICAO address or registration before searching.";
            _success = null;
            return;
        }

        _loadingAircraft = true; _aircraftSearchPerformed = true; _error = null; _success = null;
        try
        {
            _aircraft = (await AircraftService.FindAsync(_aircraftAddress, _aircraftRegistration))
                .OrderBy(x => x.Address).ToList();
            ClearAircraftSelection();
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _loadingAircraft = false; }
    }

    private void EditAircraft(Aircraft record)
    {
        _aircraftEditModel = Copy(record);
        _selectedManufacturerId = _models
            .FirstOrDefault(x => x.Id == record.ModelId)?.ManufacturerId ?? 0;
    }
    private void SelectAircraftFromKeyboard(KeyboardEventArgs args, Aircraft record)
    {
        if (args.Key is "Enter" or " ")
        {
            EditAircraft(record);
        }
    }

    private async Task SaveAircraftAsync()
    {
        if (!CanEditAircraft)
        {
            return;
        }
        _saving = true; _error = null; _success = null;
        try
        {
            var isNew = _aircraftEditModel.Id == 0;
            var saved = await AircraftService.SaveAsync(_aircraftEditModel);
            if (string.IsNullOrWhiteSpace(_aircraftAddress) &&
                string.IsNullOrWhiteSpace(_aircraftRegistration))
            {
                _aircraftAddress = saved.Address;
            }
            await FindAircraftAsync();
            _success = isNew ? "Aircraft record added." : "Aircraft record updated.";
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _saving = false; }
    }

    private void ConfirmDeleteAircraft(Aircraft aircraft)
    {
        if (_saving || TrackingControl.IsTracking)
        {
            return;
        }
        _deleteAircraft = Copy(aircraft);
        _aircraftDeleteError = null;
    }

    private void CloseDeleteAircraft()
    {
        if (_saving)
        {
            return;
        }
        _deleteAircraft = null;
        _aircraftDeleteError = null;
    }

    private async Task DeleteAircraftAsync()
    {
        if (_deleteAircraft is null || TrackingControl.IsTracking)
        {
            return;
        }
        _saving = true; _error = null; _success = null;
        try
        {
            await AircraftService.DeleteAsync(_deleteAircraft.Id);
            _deleteAircraft = null;
            await FindAircraftAsync();
            _success = "Aircraft record deleted.";
        }
        catch (Exception exception) { _aircraftDeleteError = exception.Message; }
        finally { _saving = false; }
    }

    private void HandleDeleteAircraftKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseDeleteAircraft();
        }
    }

    private void SelectManufacturer(ChangeEventArgs args)
    {
        _selectedManufacturerId = int.TryParse(args.Value?.ToString(), out var id) ? id : 0;
        if (!_models.Any(x => x.Id == _aircraftEditModel.ModelId &&
                             x.ManufacturerId == _selectedManufacturerId))
        {
            _aircraftEditModel.ModelId = 0;
        }
    }

    private void ClearAircraftSelection()
    {
        _aircraftEditModel = new();
        _selectedManufacturerId = 0;
    }

    private void SelectType(DataImportType importType) { _importType = importType; _error = null; _success = null; }
    private void SelectFile(InputFileChangeEventArgs args)
    {
        _file = args.File; _success = null;
        _error = !string.Equals(Path.GetExtension(_file.Name), ".csv", StringComparison.OrdinalIgnoreCase)
            ? "Select a file with a .csv extension." : _file.Size > MaximumFileSize ? "The selected file is larger than 50 MB." : null;
    }

    private async Task ImportAsync()
    {
        if (!CanImport || _file is null)
        {
            return;
        }
        _importing = true; _error = null; _success = null;
        try
        {
            await using var stream = _file.OpenReadStream(MaximumFileSize);
            await ImportService.ImportAsync(_importType, stream, _file.Name);
            _success = $"{SelectedOption.Name} were imported from {_file.Name}.";
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _importing = false; }
    }

    private static Provenance Copy(Provenance source) => new()
    {
        Id = source.Id, SourceRef = source.SourceRef, Source = source.Source, SourceUrl = source.SourceUrl,
        SourceDataset = source.SourceDataset, SourceVersion = source.SourceVersion, Licence = source.Licence
    };
    private static Aircraft Copy(Aircraft source) => new()
    {
        Id = source.Id, Address = source.Address, Registration = source.Registration,
        Manufactured = source.Manufactured, Age = source.Age, ModelId = source.ModelId,
        ProvenanceId = source.ProvenanceId
    };
    private static string ModelLabel(Model model) =>
        string.IsNullOrWhiteSpace(model.ICAO) ? model.Name : $"{model.ICAO} - {model.Name}";
    private static string FormatSize(long bytes) => bytes < 1024 * 1024 ? $"{Math.Max(1, bytes / 1024d):0.#} KB" : $"{bytes / 1024d / 1024d:0.#} MB";
    private sealed record ImportOption(DataImportType Type, string Name, string Description);
    private enum ReferenceTab { Import, Provenance, Aircraft, Airlines, Airports, Flights, Manufacturers, Models }
}
