@page "/weather"
@page "/lookup/weather"
@inject IAirportWeatherLookupService WeatherService
@inject ITrackerHubPageState PageState

<PageTitle>Airport Weather · ADS-B Tracker</PageTitle>

<LookupTabs />

<section class="lookup-tab-heading">
    <p class="eyebrow">Aviation reports</p>
    <h2>Weather</h2>
    <p>Retrieve and decode current observations or terminal forecasts for a selected airport.</p>
</section>

<form class="weather-search" @onsubmit="LookupAsync" @onsubmit:preventDefault>
    <div class="weather-fields">
        <label>
            <span>Report type</span>
            <select value="@_endpointType" @onchange="ChangeReportType">
                <option value="@ApiEndpointType.METAR">Current weather (METAR)</option>
                <option value="@ApiEndpointType.TAF">Weather forecast (TAF)</option>
            </select>
        </label>
        <label>
            <span>API service</span>
            <select @bind="_serviceType" disabled="@(_services.Count == 0)">
                @if (_services.Count == 0)
                {
                    <option value="@ApiServiceType.None">No configured services</option>
                }
                else
                {
                    @foreach (var service in _services)
                    {
                        <option value="@service">@service</option>
                    }
                }
            </select>
        </label>
        <label>
            <span>Airport</span>
            <select @bind="_icao" disabled="@(_airports.Count == 0)">
                @if (_airports.Count == 0)
                {
                    <option value="">No airports available</option>
                }
                else
                {
                    @foreach (var airport in _airports)
                    {
                        <option value="@airport.ICAO">@airport.DisplayName</option>
                    }
                }
            </select>
        </label>
        <button class="primary-button" type="submit" disabled="@(!CanLookup)">
            @(_loading ? "Looking up…" : "Look up weather")
        </button>
    </div>
    <p class="weather-service-note">Only services with a configured @_endpointType endpoint are available.</p>
</form>

@if (_error is not null)
{
    <div class="alert" role="alert"><strong>Weather lookup failed</strong><span>@_error</span></div>
}

@if (_searched && !_loading && _error is null && _reports.Count == 0)
{
    <section class="weather-empty">
        <strong>No weather reports returned</strong>
        <p>@_serviceType did not return @ReportDescription for @_icao.</p>
    </section>
}

@if (_reports.Count > 0)
{
    <section class="weather-results" aria-live="polite">
        <div class="weather-results-heading">
            <div>
                <p class="eyebrow">@_icao · @_serviceType</p>
                <h2>@ReportHeading</h2>
            </div>
            <span>@(_reports.Count == 1 ? "1 report" : $"{_reports.Count} reports")</span>
        </div>

        @foreach (var report in _reports)
        {
            <article class="weather-report">
                <div class="weather-raw">
                    <span>Raw @_endpointType</span>
                    <code>@report.Raw</code>
                </div>
                <div class="weather-decoded">
                    <span>Decoded report</span>
                    <dl>
                        @foreach (var line in report.Decoded)
                        {
                            var separator = line.IndexOf(':');
                            if (separator > 0)
                            {
                                <div><dt>@line[..separator]</dt><dd>@line[(separator + 1)..].Trim()</dd></div>
                            }
                            else
                            {
                                <div class="weather-decoded-wide"><dd>@line</dd></div>
                            }
                        }
                    </dl>
                </div>
            </article>
        }
    </section>
}

@code {
#nullable enable
    [Parameter]
    [SupplyParameterFromQuery(Name = "iata")]
    public string? Iata { get; set; }

    private ApiEndpointType _endpointType = ApiEndpointType.METAR;
    private ApiServiceType _serviceType = ApiServiceType.None;
    private IReadOnlyList<ApiServiceType> _services = [];
    private IReadOnlyList<AirportWeatherOption> _airports = [];
    private IReadOnlyList<AirportWeatherReport> _reports = [];
    private string _icao = string.Empty;
    private string? _error;
    private bool _loading;
    private bool _searched;
    private bool _parametersHandled;
    private string _handledIata = string.Empty;
    private bool CanLookup => !_loading && _services.Count > 0 && IsValidIcao(_icao);
    private string ReportHeading => _endpointType == ApiEndpointType.METAR ? "Current weather" : "Weather forecast";
    private string ReportDescription => _endpointType == ApiEndpointType.METAR ? "a current observation" : "a forecast";

    /// <summary>
    /// Loads the configured METAR services and selectable airports when the page is initialised.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Start with the current-weather service choices shown in the initial report-type selector.
        RefreshServices();

        // Select the first airport so a populated database produces a ready-to-use form.
        _airports = await WeatherService.GetAirportsAsync();
        _icao = _airports.FirstOrDefault()?.ICAO ?? string.Empty;
    }

    /// <summary>
    /// Resolves a schedule-supplied IATA code, selects METAR mode, and runs the lookup automatically.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        var requestedIata = Iata?.Trim().ToUpperInvariant() ?? string.Empty;
        if (_parametersHandled &&
            string.Equals(requestedIata, _handledIata, StringComparison.Ordinal))
        {
            return;
        }

        _parametersHandled = true;
        _handledIata = requestedIata;
        if (string.IsNullOrEmpty(requestedIata))
        {
            if (PageState.Weather is not { } saved) return;

            // Restore only scoped in-process values when no explicit schedule link supplied an airport.
            _endpointType = saved.Endpoint;
            RefreshServices();
            _serviceType = _services.Contains(saved.Service) ? saved.Service : _services.FirstOrDefault();
            _icao = _airports.Any(airport =>
                string.Equals(airport.ICAO, saved.Icao, StringComparison.OrdinalIgnoreCase))
                ? saved.Icao
                : string.Empty;
            if (CanLookup) await LookupAsync();
            return;
        }

        _endpointType = ApiEndpointType.METAR;
        RefreshServices();
        _reports = [];
        _searched = false;
        var airport = _airports.FirstOrDefault(option =>
            string.Equals(option.IATA, requestedIata, StringComparison.OrdinalIgnoreCase));
        if (airport is null)
        {
            _error = $"Airport {requestedIata} does not exist in the airport database.";
            return;
        }

        if (!IsValidIcao(airport.ICAO))
        {
            _error = $"Airport {requestedIata} does not have a valid ICAO code for weather lookup.";
            return;
        }

        if (_services.Count == 0)
        {
            _error = "No API service is configured for METAR lookups.";
            return;
        }

        _error = null;
        _icao = airport.ICAO;
        await LookupAsync();
    }

    /// <summary>
    /// Applies a changed report type and refreshes its compatible service choices.
    /// </summary>
    /// <param name="args">The report-type selection event.</param>
    private void ChangeReportType(ChangeEventArgs args)
    {
        // The select contains only supported enum values, but retain the current value if parsing fails.
        if (Enum.TryParse<ApiEndpointType>(args.Value?.ToString(), out var endpointType))
        {
            _endpointType = endpointType;
            _reports = [];
            _error = null;
            _searched = false;
            RefreshServices();
        }
    }

    /// <summary>
    /// Filters configured API services for the selected weather report type.
    /// </summary>
    private void RefreshServices()
    {
        // Select the first compatible service so the form always has a usable default when one exists.
        _services = WeatherService.GetServices(_endpointType);
        _serviceType = _services.FirstOrDefault();
    }

    /// <summary>
    /// Performs the selected airport weather lookup and updates the displayed results.
    /// </summary>
    private async Task LookupAsync()
    {
        if (!CanLookup) return;

        _loading = true;
        _searched = true;
        _error = null;
        _reports = [];
        _icao = _icao.Trim().ToUpperInvariant();
        // Retain submitted criteria in this UI session only; nothing is serialized or persisted.
        PageState.Weather = new WeatherPageState(_endpointType, _serviceType, _icao);

        try
        {
            // The service validates the selection and returns raw reports already paired with decoded lines.
            _reports = await WeatherService.LookupAsync(_endpointType, _serviceType, _icao);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Determines whether a selected value is a four-letter airport ICAO code.
    /// </summary>
    /// <param name="icao">The user-entered airport code.</param>
    /// <returns>True when the code contains exactly four ASCII letters.</returns>
    private static bool IsValidIcao(string icao)
    {
        // Retain boundary validation even though selector values originate in the database.
        var value = icao?.Trim() ?? string.Empty;
        return value.Length == 4 && value.All(character => character is >= 'A' and <= 'Z' or >= 'a' and <= 'z');
    }
}
