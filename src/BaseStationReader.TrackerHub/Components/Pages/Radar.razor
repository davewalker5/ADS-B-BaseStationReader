@page "/radar"
@inject NavigationManager Navigation

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "address")]
    public string? Address { get; set; }

    protected override void OnInitialized()
    {
        var destination = string.IsNullOrWhiteSpace(Address)
            ? "/?tab=radar"
            : $"/?tab=radar&address={Uri.EscapeDataString(Address)}";

        Navigation.NavigateTo(destination, replace: true);
    }
}
