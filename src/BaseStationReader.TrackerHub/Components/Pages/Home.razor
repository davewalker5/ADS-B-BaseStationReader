    /// <summary>
    /// Subscribes to service changes and starts the live transport.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Subscribe before starting so the connecting state is rendered immediately.
        LiveAircraft.StateChanged += OnLiveStateChanged;
        _maximumRadarRange = RadarConfiguration.Value.MaximumRange;
        _profiles = TrackingProfiles.List();
        _equipmentTypes = await EquipmentRegister.SearchTypesAsync(null);
        _selectedEquipmentTypeId = _equipmentTypes.FirstOrDefault()?.Id ?? 0;
        await StartAsync();
        _receiverHost = LiveAircraft.TrackingOptions?.ReceiverHost ?? string.Empty;
        _receiverPort = LiveAircraft.TrackingOptions?.ReceiverPort ?? 0;
        var activeProfile = LiveAircraft.TrackingOptions?.TrackingProfile;
        var matchingProfile = _profiles.FirstOrDefault(profile =>
            profile.FileName.Equals(activeProfile, StringComparison.OrdinalIgnoreCase));
        if (matchingProfile is not null)
        {
            _selectedProfile = matchingProfile.FileName;
        }
        else if (activeProfile?.Equals("appsettings.json", StringComparison.OrdinalIgnoreCase) == true)
        {
            _selectedProfile = TrackingProfileService.DefaultProfileValue;
        }

        // Navigating away destroys this page component while the singleton tracking runtime continues.
        // Rehydrate the workflow from that runtime so Live Tracker returns to the active session.
        if (TrackingControl.IsTracking)
        {
