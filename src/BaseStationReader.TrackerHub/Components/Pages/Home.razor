@page "/"
@implements IAsyncDisposable
@inject ILiveAircraftService LiveAircraft
@inject ITrackingProfileService TrackingProfiles
@inject ITrackingControlService TrackingControl
@inject ITrackingSessionQueryService SessionQueries
@inject Microsoft.Extensions.Options.IOptions<RadarOptions> RadarConfiguration

<PageTitle>Live Tracker · ADS-B Tracker</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">Observation workflow</p>
        <h1>Live Tracker</h1>
        <p class="lede">Prepare a session, then monitor aircraft visible to the receiver.</p>
    </div>
    <div class="connection @ConnectionClass" role="status" aria-live="polite">
        <span class="connection-dot"></span>
        <span>
            <small>Tracker connection</small>
            <strong>@ConnectionLabel</strong>
        </span>
    </div>
</section>

<div class="session-tabs" role="tablist" aria-label="Observation session">
    <button class="@TabClass(SessionTab.Preparation)" role="tab"
            aria-selected="@(_activeTab == SessionTab.Preparation)"
            @onclick="() => SelectTab(SessionTab.Preparation)">
        Session
    </button>
    <button class="@TabClass(SessionTab.Tracking)" role="tab"
            aria-selected="@(_activeTab == SessionTab.Tracking)"
            disabled="@(!TrackingControl.IsTracking)"
            @onclick="() => SelectTab(SessionTab.Tracking)">
        Tracking
    </button>
    <button class="@TabClass(SessionTab.Radar)" role="tab"
            aria-selected="@(_activeTab == SessionTab.Radar)"
            disabled="@(!TrackingControl.IsTracking)"
            @onclick="() => SelectTab(SessionTab.Radar)">
        Radar
    </button>
    <button class="@TabClass(SessionTab.Summary)" role="tab"
            aria-selected="@(_activeTab == SessionTab.Summary)"
            disabled="@(!_sessionStarted)"
            @onclick="() => SelectTab(SessionTab.Summary)">
        Summary
    </button>
</div>

@if (_activeTab == SessionTab.Preparation)
{
    <section class="session-preparation" aria-label="Session preparation">
        <div class="session-form">
            <div class="session-form-heading">
                <div>
                    <h2>Prepare session</h2>
                    <p>Choose the conditions that will be recorded with this tracking run.</p>
                </div>
                @if (_sessionStarted)
                {
                    <span class="read-only-badge"><span>●</span> @(TrackingControl.IsTracking ? "Session active" : "Session complete") · read only</span>
                }
            </div>

            <label class="session-field" for="tracking-profile">
                <span>Tracking profile</span>
                <select id="tracking-profile" value="@_selectedProfile" @onchange="OnProfileChangedAsync"
                        disabled="@(_applyingProfile || _sessionStarted || _profiles.Count == 0)">
                    @foreach (var profile in _profiles)
                    {
                        <option value="@profile.FileName">@profile.DisplayName</option>
                    }
                </select>
            </label>

            <div class="receiver-endpoint">
                <label class="session-field" for="receiver-host">
                    <span>Receiver host</span>
                    <input id="receiver-host" @bind="_receiverHost" disabled="@_sessionStarted" />
                </label>
                <label class="session-field" for="receiver-port">
                    <span>Receiver port</span>
                    <input id="receiver-port" type="number" min="1" max="65535"
                           @bind="_receiverPort" disabled="@_sessionStarted" />
                </label>
            </div>

            <div class="effective-profile" aria-label="Effective tracking profile">
                <h3>Effective tracking profile</h3>
                <dl>
                    <div><dt>Profile</dt><dd>@EffectiveProfileName</dd></div>
                    <div><dt>Latitude</dt><dd>@FormatCoordinate(LiveAircraft.TrackingOptions?.ReceiverLatitude)</dd></div>
                    <div><dt>Longitude</dt><dd>@FormatCoordinate(LiveAircraft.TrackingOptions?.ReceiverLongitude)</dd></div>
                    <div><dt>Elevation</dt><dd>@FormatValue(LiveAircraft.TrackingOptions?.ReceiverElevation, " ft")</dd></div>
                    <div><dt>Minimum altitude</dt><dd>@FormatValue(LiveAircraft.TrackingOptions?.MinimumTrackedAltitude, " ft")</dd></div>
                    <div><dt>Maximum altitude</dt><dd>@FormatValue(LiveAircraft.TrackingOptions?.MaximumTrackedAltitude, " ft")</dd></div>
                    <div><dt>Maximum distance</dt><dd>@FormatValue(LiveAircraft.TrackingOptions?.MaximumTrackedDistance, " nm")</dd></div>
                    <div><dt>Included behaviours</dt><dd>@Display(LiveAircraft.TrackingOptions?.TrackedBehaviours)</dd></div>
                </dl>
            </div>

            <label class="session-field" for="session-notes">
                <span>Session notes <small>Optional</small></span>
                <textarea id="session-notes" @bind="_sessionNotes" maxlength="4000" rows="5"
                          disabled="@_sessionStarted"
                          placeholder="Purpose, weather conditions, or other context…"></textarea>
            </label>

            <div class="session-actions">
                <button class="primary-button" @onclick="StartTrackingAsync"
                        disabled="@(_controlsBusy || _applyingProfile || _sessionStarted)">
                    @(_controlsBusy ? "Starting…" : "Start Session")
                </button>
                @if (_profileMessage is not null)
                {
                    <span class="profile-message @(_profileError ? "error" : "success")" role="status">@_profileMessage</span>
                }
            </div>
        </div>
    </section>
}

@if (_startError is not null)
{
    <div class="alert" role="alert">
        <strong>Tracker connection unavailable</strong>
        <span>@_startError</span>
        <button @onclick="RetryAsync">Try again</button>
    </div>
}

@if (_activeTab == SessionTab.Summary && _sessionStarted)
{
    <section class="session-summary" aria-label="Observation session summary" aria-busy="@_summaryLoading">
        <div class="summary-heading">
            <div>
                <p class="eyebrow">Observation Snapshot</p>
                <h2>Session Summary</h2>
                <p>@(TrackingControl.IsTracking ? "Observations recorded so far." : "Review the completed observation session.")</p>
            </div>
            <div class="summary-actions">
                <button class="secondary-button" @onclick="LoadSummaryAsync" disabled="@_summaryLoading">
                    @(_summaryLoading ? "Refreshing…" : "Refresh")
                </button>
                @if (!TrackingControl.IsTracking)
                {
                    <button class="primary-button" @onclick="PrepareNewSession">New Session</button>
                }
            </div>
        </div>

        @if (_summaryError is not null)
        {
            <div class="alert" role="alert"><strong>Summary unavailable</strong><span>@_summaryError</span></div>
        }
        else if (_summary is null)
        {
            <div class="summary-empty">@(_summaryLoading ? "Reading persisted observations…" : "No persisted summary is available yet.")</div>
        }
        else
        {
            <section class="summary-section">
                <h3>Session</h3>
                <dl class="summary-details">
                    <div><dt>Started</dt><dd>@FormatUtcTimestamp(_summary.StartedAtUtc)</dd></div>
                    <div><dt>Last activity</dt><dd>@FormatLocalTimestamp(_summary.LastActivity)</dd></div>
                    <div><dt>Observed duration</dt><dd>@FormatDuration(_summary.ObservedDuration)</dd></div>
                    <div><dt>Tracking profile</dt><dd>@Display(_summary.ProfileName)</dd></div>
                    <div><dt>Receiver location</dt><dd>@FormatLocation(_summary)</dd></div>
                    <div><dt>Tracking limits</dt><dd>@FormatLimits(_summary)</dd></div>
                    <div class="wide"><dt>Included behaviours</dt><dd>@Display(_summary.IncludedBehaviours.Replace(",", ", "))</dd></div>
                    <div class="wide"><dt>Session notes</dt><dd class="summary-notes">@Display(_summary.Notes)</dd></div>
                </dl>
            </section>

            <section class="summary-section">
                <h3>Observation totals</h3>
                <div class="session-metrics">
                    @foreach (var metric in ObservationMetrics(_summary))
                    {
                        <article class="session-metric">
                            <span>@metric.Label</span><strong>@metric.Value.ToString("N0")</strong>
                        </article>
                    }
                </div>
            </section>

            <section class="summary-section">
                <h3>Identification</h3>
                <div class="session-metrics">
                    @foreach (var metric in IdentificationMetrics(_summary))
                    {
                        <article class="session-metric">
                            <span>@metric.Label</span><strong>@metric.Value.ToString("N0")</strong>
                            @if (metric.Detail is not null) { <small>@metric.Detail</small> }
                        </article>
                    }
                </div>
            </section>

            <section class="summary-section">
                <h3>Session highlights</h3>
                <div class="highlight-grid">
                    @foreach (var highlight in Highlights(_summary))
                    {
                        <article class="session-highlight">
                            <span>@highlight.Label</span><strong>@highlight.Value</strong>
                            <small>@(highlight.Item is null ? "No recorded value" : DisplayAircraft(highlight.Item))</small>
                        </article>
                    }
                </div>
            </section>
        }
    </section>
}

@if (_activeTab == SessionTab.Radar && TrackingControl.IsTracking)
{
    <section class="radar-tab" aria-label="Live radar">
        <div class="radar-tab-heading">
            <div>
                <p class="eyebrow">Receiver-relative surveillance</p>
                <h2>Live Radar</h2>
                <p>Current aircraft range and bearing from the active receiver.</p>
            </div>
            <label class="radar-range">
                <span>Displayed range</span>
                <select @bind="_maximumRadarRange">
                    <option value="10">10 nm</option>
                    <option value="25">25 nm</option>
                    <option value="50">50 nm</option>
                    <option value="100">100 nm</option>
                    <option value="200">200 nm</option>
                </select>
            </label>
        </div>

        <section class="radar-summary" aria-label="Radar summary">
            <span><strong>@LiveAircraft.Aircraft.Count</strong> tracked</span>
            <span><strong>@PositionedAircraftCount</strong> positioned</span>
            <span><strong>@(LiveAircraft.TrackingOptions?.TrackingProfile ?? "Loading…")</strong> profile</span>
            <span class="connection @ConnectionClass"><i class="connection-dot"></i><strong>@LiveAircraft.ConnectionState</strong></span>
        </section>

        <RadarDisplay Aircraft="LiveAircraft.Aircraft" MaximumRange="_maximumRadarRange"
                      Options="RadarConfiguration.Value" ConnectionState="LiveAircraft.ConnectionState"
                      SelectedAddress="@Address" />
    </section>
}

@if (_activeTab == SessionTab.Tracking && TrackingControl.IsTracking)
{
<section class="session-status" aria-label="Session status">
    <div>
        <span class="live-indicator"><i></i> Session active</span>
        <strong>@EffectiveProfileName</strong>
    </div>
    <button class="secondary-button" @onclick="StopTrackingAsync" disabled="@_controlsBusy">
        @(_controlsBusy ? "Stopping…" : "Stop Session")
    </button>
</section>

<section class="summary-grid" aria-label="Tracker summary">
    <article class="summary-card accent">
        <span>Aircraft</span>
        <strong>@LiveAircraft.Aircraft.Count</strong>
        <small>currently tracked</small>
    </article>
    <article class="summary-card">
        <span>Tracking profile</span>
        <strong class="text-value">@(LiveAircraft.TrackingOptions?.TrackingProfile ?? "Loading…")</strong>
        <small>active receiver profile</small>
    </article>
    <article class="summary-card">
        <span>Most recent update</span>
        <strong class="text-value">@FormatUpdated(LiveAircraft.LastUpdated)</strong>
        <small>@FormatUpdateAge(LiveAircraft.LastUpdated)</small>
    </article>
</section>

<section class="tracker-panel">
    <div class="panel-heading">
        <div>
            <h2>Tracked aircraft</h2>
            <p>Select a row to inspect its latest details.</p>
        </div>
        <label class="search">
            <span class="sr-only">Filter aircraft</span>
            <input type="search" @bind="_filter" @bind:event="oninput" placeholder="Filter callsign or ICAO…" />
        </label>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th><button @onclick="() => SortBy(SortColumn.Callsign)">Callsign @SortIndicator(SortColumn.Callsign)</button></th>
                    <th><button @onclick="() => SortBy(SortColumn.Address)">ICAO @SortIndicator(SortColumn.Address)</button></th>
                    <th>Status</th>
                    <th class="numeric"><button @onclick="() => SortBy(SortColumn.Altitude)">Altitude @SortIndicator(SortColumn.Altitude)</button></th>
                    <th class="numeric">V/S</th>
                    <th class="numeric">Speed</th>
                    <th class="numeric">Heading</th>
                    <th class="numeric"><button @onclick="() => SortBy(SortColumn.Distance)">Distance @SortIndicator(SortColumn.Distance)</button></th>
                    <th class="numeric">Messages</th>
                    <th><button @onclick="() => SortBy(SortColumn.LastSeen)">Last seen @SortIndicator(SortColumn.LastSeen)</button></th>
                    <th>Lookup</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredAircraft.Any())
                {
                    <tr><td colspan="11" class="table-empty">@EmptyMessage</td></tr>
                }
                else
                {
                    @foreach (var aircraft in FilteredAircraft)
                    {
                        <tr class="@StatusClass(aircraft.Status) @SelectedClass(aircraft)" @onclick="() => SelectAircraft(aircraft)">
                            <td>
                                @if (string.IsNullOrWhiteSpace(aircraft.Callsign))
                                {
                                    <strong>—</strong>
                                }
                                else
                                {
                                    <a class="row-link" href="@HistoryCallsignUrl(aircraft)" @onclick:stopPropagation><strong>@aircraft.Callsign.Trim()</strong> →</a>
                                }
                            </td>
                            <td class="mono"><a class="row-link" href="@HistoryUrl(aircraft)" @onclick:stopPropagation>@aircraft.Address →</a></td>
                            <td><span class="status-pill @StatusClass(aircraft.Status)">@aircraft.Status</span></td>
                            <td class="numeric">@FormatNumber(aircraft.Altitude, "N0", " ft")</td>
                            <td class="numeric behaviour">@BehaviourIndicator(aircraft.Behaviour) @FormatNumber(aircraft.VerticalRate, "N0", " fpm")</td>
                            <td class="numeric">@FormatNumber(aircraft.GroundSpeed, "N0", " kt")</td>
                            <td class="numeric">@FormatNumber(aircraft.Track, "N0", "°")</td>
                            <td class="numeric">
                                @if (aircraft.Distance.HasValue)
                                {
                                    <a class="row-link" href="@RadarUrl(aircraft)" @onclick:stopPropagation>@FormatNumber(aircraft.Distance, "N1", " nm") →</a>
                                }
                                else
                                {
                                    @FormatNumber(aircraft.Distance, "N1", " nm")
                                }
                            </td>
                            <td class="numeric">@aircraft.Messages.ToString("N0")</td>
                            <td><time datetime="@aircraft.LastSeen.ToString("O")">@aircraft.LastSeen.ToLocalTime().ToString("HH:mm:ss")</time></td>
                            <td><a class="row-link" href="@LookupUrl(aircraft)" @onclick:stopPropagation>Lookup →</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@if (_selected is not null)
{
    <aside class="detail-panel" aria-label="Selected aircraft details">
        <div class="detail-heading">
            <div>
                <p class="eyebrow">Selected aircraft</p>
                <h2>@Display(_selected.Callsign)</h2>
                <span class="mono">@_selected.Address</span>
            </div>
            <button class="icon-button" @onclick="ClearSelection" aria-label="Close aircraft details">×</button>
        </div>
        <dl class="detail-grid">
            <div><dt>Status</dt><dd><span class="status-pill @StatusClass(_selected.Status)">@_selected.Status</span></dd></div>
            <div><dt>Squawk</dt><dd>@Display(_selected.Squawk)</dd></div>
            <div><dt>Behaviour</dt><dd>@_selected.Behaviour</dd></div>
            <div><dt>Altitude</dt><dd>@FormatNumber(_selected.Altitude, "N0", " ft")</dd></div>
            <div><dt>Latitude</dt><dd>@FormatNumber(_selected.Latitude, "N5")</dd></div>
            <div><dt>Longitude</dt><dd>@FormatNumber(_selected.Longitude, "N5")</dd></div>
            <div><dt>Ground speed</dt><dd>@FormatNumber(_selected.GroundSpeed, "N0", " kt")</dd></div>
            <div><dt>Vertical rate</dt><dd>@FormatNumber(_selected.VerticalRate, "N0", " fpm")</dd></div>
            <div><dt>Track</dt><dd>@FormatNumber(_selected.Track, "N0", "°")</dd></div>
            <div><dt>Distance</dt><dd>@FormatNumber(_selected.Distance, "N1", " nm")</dd></div>
        </dl>
    </aside>
}
}

@code {
#nullable enable
    private TrackedAircraftDto? _selected;
    private string _filter = string.Empty;
    private string? _startError;
    private SortColumn _sortColumn = SortColumn.Arrival;
    private bool _ascending;
    private IReadOnlyList<TrackingProfileOption> _profiles = [];
    private string _selectedProfile = TrackingProfileService.DefaultProfileValue;
    private string? _profileMessage;
    private bool _profileError;
    private bool _applyingProfile;
    private bool _controlsBusy;
    private string _sessionNotes = string.Empty;
    private string _receiverHost = string.Empty;
    private int _receiverPort;
    private SessionTab _activeTab = SessionTab.Preparation;
    private bool _sessionStarted;
    private bool _summaryLoading;
    private int? _sessionId;
    private ObservationSessionSummaryDto? _summary;
    private string? _summaryError;
    private double _maximumRadarRange;

    [Parameter]
    [SupplyParameterFromQuery(Name = "tab")]
    public string? RequestedTab { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "address")]
    public string? Address { get; set; }

    /// <summary>
    /// Builds a Lookup-tab URL populated from a live aircraft row.
    /// </summary>
    /// <param name="aircraft">The live aircraft to look up.</param>
    /// <returns>The encoded Lookup-tab URL.</returns>
    private static string LookupUrl(TrackedAircraftDto aircraft)
        => $"lookup?address={Uri.EscapeDataString(aircraft.Address ?? string.Empty)}" +
           $"&callsign={Uri.EscapeDataString(aircraft.Callsign ?? string.Empty)}";

    /// <summary>
    /// Builds a Database-tab URL filtered to the live aircraft's ICAO address.
    /// </summary>
    private static string HistoryUrl(TrackedAircraftDto aircraft)
        => $"history?address={Uri.EscapeDataString(aircraft.Address ?? string.Empty)}";

    /// <summary>
    /// Builds a Database-tab URL filtered to the live aircraft's callsign.
    /// </summary>
    private static string HistoryCallsignUrl(TrackedAircraftDto aircraft)
        => $"history?callsign={Uri.EscapeDataString(aircraft.Callsign?.Trim() ?? string.Empty)}";

    /// <summary>
    /// Builds a Radar-tab URL that selects the live aircraft.
    /// </summary>
    private static string RadarUrl(TrackedAircraftDto aircraft)
        => $"?tab=radar&address={Uri.EscapeDataString(aircraft.Address ?? string.Empty)}";

    private IEnumerable<TrackedAircraftDto> FilteredAircraft
    {
        get
        {
            // Filter before sorting to minimise work as the live collection grows.
            var aircraft = LiveAircraft.Aircraft.Where(a =>
                string.IsNullOrWhiteSpace(_filter) ||
                a.Address.Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
                (a.Callsign?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false));

            return (_sortColumn, _ascending) switch
            {
                (SortColumn.Address, true) => aircraft.OrderBy(a => a.Address),
                (SortColumn.Address, false) => aircraft.OrderByDescending(a => a.Address),
                (SortColumn.Callsign, true) => aircraft.OrderBy(a => a.Callsign),
                (SortColumn.Callsign, false) => aircraft.OrderByDescending(a => a.Callsign),
                (SortColumn.Altitude, true) => aircraft.OrderBy(a => a.Altitude),
                (SortColumn.Altitude, false) => aircraft.OrderByDescending(a => a.Altitude),
                (SortColumn.Distance, true) => aircraft.OrderBy(a => a.Distance),
                (SortColumn.Distance, false) => aircraft.OrderByDescending(a => a.Distance),
                (SortColumn.LastSeen, true) => aircraft.OrderBy(a => a.LastSeen),
                (SortColumn.LastSeen, false) => aircraft.OrderByDescending(a => a.LastSeen),
                _ => aircraft
            };
        }
    }

    private string ConnectionClass => LiveAircraft.ConnectionState.ToString().ToLowerInvariant();
    private string ConnectionLabel => LiveAircraft.ConnectionState switch
    {
        ConnectionState.Connected => "Connected",
        ConnectionState.Reconnecting => "Reconnecting…",
        ConnectionState.Connecting => "Connecting…",
        _ => "Disconnected"
    };
    private string EmptyMessage => string.IsNullOrWhiteSpace(_filter)
        ? "Waiting for aircraft messages…"
        : "No aircraft match this filter.";
    private int PositionedAircraftCount => LiveAircraft.Aircraft.Count(aircraft =>
        aircraft.Distance.HasValue && aircraft.Latitude.HasValue && aircraft.Longitude.HasValue);

    private static string FormatCoordinate(double? coordinate)
        => coordinate?.ToString("F6") ?? "Not configured";

    private static string FormatValue(int? value, string suffix)
        => value.HasValue ? $"{value:N0}{suffix}" : "Not configured";

    private string EffectiveProfileName
        => LiveAircraft.TrackingOptions?.TrackingProfileName ?? "Loading…";

    protected override void OnParametersSet()
    {
        // Aircraft links update only the query string while this component remains mounted.
        if (TrackingControl.IsTracking &&
            RequestedTab?.Equals("radar", StringComparison.OrdinalIgnoreCase) == true)
        {
            _activeTab = SessionTab.Radar;
        }
    }

    /// <summary>
    /// Subscribes to service changes and starts the live transport.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Subscribe before starting so the connecting state is rendered immediately.
        LiveAircraft.StateChanged += OnLiveStateChanged;
        _maximumRadarRange = RadarConfiguration.Value.MaximumRange;
        _profiles = TrackingProfiles.List();
        await StartAsync();
        _receiverHost = LiveAircraft.TrackingOptions?.ReceiverHost ?? string.Empty;
        _receiverPort = LiveAircraft.TrackingOptions?.ReceiverPort ?? 0;
        var activeProfile = LiveAircraft.TrackingOptions?.TrackingProfile;
        var matchingProfile = _profiles.FirstOrDefault(profile =>
            profile.FileName.Equals(activeProfile, StringComparison.OrdinalIgnoreCase));
        if (matchingProfile is not null)
        {
            _selectedProfile = matchingProfile.FileName;
        }
        else if (activeProfile?.Equals("appsettings.json", StringComparison.OrdinalIgnoreCase) == true)
        {
            _selectedProfile = TrackingProfileService.DefaultProfileValue;
        }

        // Navigating away destroys this page component while the singleton tracking runtime continues.
        // Rehydrate the workflow from that runtime so Live Tracker returns to the active session.
        if (TrackingControl.IsTracking)
        {
            _sessionStarted = true;
            _sessionId = await SessionQueries.GetLatestSessionIdAsync();
            _activeTab = RequestedTab?.Equals("radar", StringComparison.OrdinalIgnoreCase) == true
                ? SessionTab.Radar
                : SessionTab.Tracking;
        }
    }

    /// <summary>
    /// Unsubscribes the component when its circuit is released.
    /// </summary>
    public ValueTask DisposeAsync()
    {
        // The scoped service owns its connection and is disposed with the circuit.
        LiveAircraft.StateChanged -= OnLiveStateChanged;
        return ValueTask.CompletedTask;
    }

    /// <summary>
    /// Starts the live service and captures a user-readable connection error.
    /// </summary>
    private async Task StartAsync()
    {
        try
        {
            // Clear an earlier failure before attempting a fresh connection.
            _startError = null;
            await LiveAircraft.StartAsync();
        }
        catch (Exception exception)
        {
            _startError = exception.Message;
        }
    }

    /// <summary>
    /// Retries a failed initial Tracker Hub connection.
    /// </summary>
    private Task RetryAsync()
    {
        // Re-run the same guarded startup path used during initialisation.
        return StartAsync();
    }

    private async Task OnProfileChangedAsync(ChangeEventArgs args)
    {
        _selectedProfile = args.Value?.ToString() ?? TrackingProfileService.DefaultProfileValue;
        if (string.IsNullOrWhiteSpace(_selectedProfile)) return;
        _applyingProfile = true;
        _profileMessage = null;
        try
        {
            await TrackingProfiles.ApplyAsync(_selectedProfile);
            _profileError = false;
            _profileMessage = "Effective profile updated.";
        }
        catch (Exception exception)
        {
            _profileError = true;
            _profileMessage = exception.Message;
        }
        finally
        {
            _applyingProfile = false;
        }
    }

    private Task StartTrackingAsync() => SetTrackingAsync(start: true);

    private Task StopTrackingAsync() => SetTrackingAsync(start: false);

    private async Task SetTrackingAsync(bool start)
    {
        _controlsBusy = true;
        _profileMessage = null;
        try
        {
            int? previousSessionId = null;
            if (start)
            {
                previousSessionId = await SessionQueries.GetLatestSessionIdAsync();
                await TrackingControl.StartAsync(_receiverHost, _receiverPort, _sessionNotes);
            }
            else
            {
                await TrackingControl.StopAsync();
            }
            _profileError = false;
            if (start)
            {
                _sessionStarted = true;
                _sessionId = await WaitForNewSessionIdAsync(previousSessionId);
                _summary = null;
                _activeTab = SessionTab.Tracking;
            }
            else
            {
                _selected = null;
                _activeTab = SessionTab.Summary;
                await LoadSummaryAsync();
            }
        }
        catch (Exception exception)
        {
            _profileError = true;
            _profileMessage = exception.Message;
        }
        finally
        {
            _controlsBusy = false;
        }
    }

    private async Task<int?> WaitForNewSessionIdAsync(int? previousSessionId)
    {
        // Controller startup is long-running; briefly wait for its initial session insert to become visible.
        for (var attempt = 0; attempt < 40; attempt++)
        {
            var sessionId = await SessionQueries.GetLatestSessionIdAsync();
            if (sessionId.HasValue && sessionId != previousSessionId) return sessionId;
            await Task.Delay(25);
        }
        return null;
    }

    /// <summary>
    /// Schedules a render when live state changes on a SignalR callback thread.
    /// </summary>
    private void OnLiveStateChanged(object? sender, EventArgs args)
    {
        // Marshal the render onto Blazor's component dispatcher.
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task SelectTab(SessionTab tab)
    {
        if ((tab == SessionTab.Tracking || tab == SessionTab.Radar) && !TrackingControl.IsTracking) return;
        if (tab == SessionTab.Summary && !_sessionStarted) return;
        _activeTab = tab;
        if (tab == SessionTab.Summary && (_summary is null || TrackingControl.IsTracking))
        {
            await LoadSummaryAsync();
        }
    }

    private string TabClass(SessionTab tab) => _activeTab == tab ? "active" : string.Empty;

    private async Task LoadSummaryAsync()
    {
        if (!_sessionStarted || _summaryLoading) return;
        _summaryLoading = true;
        _summaryError = null;
        try
        {
            _summary = _sessionId.HasValue
                ? await SessionQueries.GetObservationSessionSummaryAsync(_sessionId.Value)
                : null;
        }
        catch (Exception exception)
        {
            _summaryError = exception.Message;
        }
        finally
        {
            _summaryLoading = false;
        }
    }

    private void PrepareNewSession()
    {
        if (TrackingControl.IsTracking) return;
        _sessionStarted = false;
        _sessionId = null;
        _summary = null;
        _summaryError = null;
        _sessionNotes = string.Empty;
        _profileMessage = null;
        _activeTab = SessionTab.Preparation;
    }

    private static IEnumerable<(string Label, int Value)> ObservationMetrics(ObservationSessionSummaryDto summary) =>
    [
        ("Observation records", summary.ObservationRecords),
        ("Distinct aircraft", summary.DistinctAircraft),
        ("Distinct callsigns", summary.DistinctCallsigns),
        ("Aircraft with positions", summary.AircraftWithPositionHistory),
        ("Position records", summary.PositionRecords)
    ];

    private static IEnumerable<(string Label, int Value, string? Detail)> IdentificationMetrics(ObservationSessionSummaryDto summary) =>
    [
        ("Aircraft identified", summary.IdentifiedAircraft, $"{summary.AircraftResolutionPercentage:N1}% resolved"),
        ("Flights resolved", summary.ResolvedFlights, $"{summary.FlightResolutionPercentage:N1}% resolved"),
        ("Unidentified aircraft", summary.UnidentifiedAircraft, null)
    ];

    private static IEnumerable<(string Label, ObservationHighlightDto? Item, string Value)> Highlights(ObservationSessionSummaryDto summary) =>
    [
        ("Lowest altitude", summary.LowestAltitude, FormatHighlightAltitude(summary.LowestAltitude)),
        ("Highest altitude", summary.HighestAltitude, FormatHighlightAltitude(summary.HighestAltitude)),
        ("Furthest aircraft", summary.FurthestAircraft, FormatHighlightDistance(summary.FurthestAircraft)),
        ("Longest observed", summary.LongestObservedAircraft, FormatHighlightDuration(summary.LongestObservedAircraft))
    ];

    private static string DisplayAircraft(ObservationHighlightDto item)
        => string.IsNullOrWhiteSpace(item.Callsign) ? item.Address : $"{item.Callsign} · {item.Address}";

    private static string FormatUtcTimestamp(DateTime value)
        => DateTime.SpecifyKind(value, DateTimeKind.Utc).ToLocalTime().ToString("dd MMM yyyy · HH:mm:ss");

    private static string FormatLocalTimestamp(DateTime? value)
        => value?.ToString("dd MMM yyyy · HH:mm:ss") ?? "No activity recorded";

    private static string FormatDuration(TimeSpan duration)
        => duration.TotalHours >= 1
            ? $"{(int)duration.TotalHours}h {duration.Minutes}m {duration.Seconds}s"
            : duration.TotalMinutes >= 1 ? $"{duration.Minutes}m {duration.Seconds}s" : $"{Math.Max(0, duration.Seconds)}s";

    private static string FormatLocation(ObservationSessionSummaryDto summary)
        => summary.ReceiverLatitude.HasValue && summary.ReceiverLongitude.HasValue
            ? $"{summary.ReceiverLatitude:F6}, {summary.ReceiverLongitude:F6}" +
              (summary.ReceiverElevation.HasValue ? $" · {summary.ReceiverElevation:N0} ft" : string.Empty)
            : "Not configured";

    private static string FormatLimits(ObservationSessionSummaryDto summary)
    {
        var altitude = summary.MinimumAltitudeLimit.HasValue || summary.MaximumAltitudeLimit.HasValue
            ? $"{summary.MinimumAltitudeLimit?.ToString("N0") ?? "Any"}–{summary.MaximumAltitudeLimit?.ToString("N0") ?? "Any"} ft"
            : "Any altitude";
        var distance = summary.MaximumDistanceLimit.HasValue
            ? $"within {summary.MaximumDistanceLimit:N0} nm"
            : "any distance";
        return $"{altitude} · {distance}";
    }

    private static string FormatHighlightAltitude(ObservationHighlightDto? item)
        => item?.Altitude is decimal value ? $"{value:N0} ft" : "—";

    private static string FormatHighlightDistance(ObservationHighlightDto? item)
        => item?.Distance is double value ? $"{value:N1} nm" : "—";

    private static string FormatHighlightDuration(ObservationHighlightDto? item)
        => item?.Duration is TimeSpan value ? FormatDuration(value) : "—";

    /// <summary>
    /// Selects an aircraft for the detail panel.
    /// </summary>
    private void SelectAircraft(TrackedAircraftDto aircraft)
    {
        // Retain the latest DTO; subsequent events refresh it through the render lookup.
        _selected = aircraft;
    }

    /// <summary>
    /// Closes the selected-aircraft detail panel.
    /// </summary>
    private void ClearSelection()
    {
        // Removing the reference is enough to hide the conditional panel.
        _selected = null;
    }

    /// <summary>
    /// Changes the active table sort or reverses its direction.
    /// </summary>
    private void SortBy(SortColumn column)
    {
        // Repeated clicks toggle direction; a new column starts ascending.
        _ascending = _sortColumn == column ? !_ascending : true;
        _sortColumn = column;
    }

    /// <summary>
    /// Returns the direction marker for a sortable column.
    /// </summary>
    private string SortIndicator(SortColumn column)
    {
        // Leave inactive headings unadorned to reduce visual noise.
        return _sortColumn == column ? (_ascending ? "↑" : "↓") : string.Empty;
    }

    /// <summary>
    /// Returns a CSS class matching an aircraft tracking status.
    /// </summary>
    private static string StatusClass(TrackingStatus status)
    {
        // Enum names map directly to the status colour tokens in the stylesheet.
        return status.ToString().ToLowerInvariant();
    }

    /// <summary>
    /// Marks the currently selected table row.
    /// </summary>
    private string SelectedClass(TrackedAircraftDto aircraft)
    {
        // ICAO address provides stable selection as DTO instances are replaced by updates.
        return _selected?.Address == aircraft.Address ? "selected" : string.Empty;
    }

    /// <summary>
    /// Converts aircraft behaviour to a compact directional indicator.
    /// </summary>
    private static string BehaviourIndicator(AircraftBehaviour behaviour)
    {
        // Match the familiar indicators used by the console tracker.
        return behaviour switch
        {
            AircraftBehaviour.Climbing => "↑",
            AircraftBehaviour.Descending => "↓",
            AircraftBehaviour.LevelFlight => "→",
            _ => "·"
        };
    }

    /// <summary>
    /// Formats a nullable numeric value and optional unit.
    /// </summary>
    private static string FormatNumber<T>(T? value, string format, string unit = "") where T : struct, IFormattable
    {
        // Use an em dash for unavailable telemetry rather than suggesting a zero value.
        return value.HasValue ? $"{value.Value.ToString(format, null)}{unit}" : "—";
    }

    /// <summary>
    /// Returns a non-empty display string.
    /// </summary>
    private static string Display(string? value)
    {
        // Callsigns and squawks can legitimately be absent from partial messages.
        return string.IsNullOrWhiteSpace(value) ? "—" : value;
    }

    /// <summary>
    /// Formats the most recent service update as local time.
    /// </summary>
    private static string FormatUpdated(DateTimeOffset? updated)
    {
        // Keep the dashboard compact while preserving second-level precision.
        return updated?.ToLocalTime().ToString("HH:mm:ss") ?? "No updates yet";
    }

    /// <summary>
    /// Describes how long ago the latest live update arrived.
    /// </summary>
    private static string FormatUpdateAge(DateTimeOffset? updated)
    {
        // Exact age continually changes, so communicate the known timestamp's date instead.
        return updated.HasValue ? updated.Value.ToLocalTime().ToString("dd MMM yyyy") : "waiting for tracker data";
    }

    private enum SortColumn
    {
        Arrival,
        Address,
        Callsign,
        Altitude,
        Distance,
        LastSeen
    }

    private enum SessionTab
    {
        Preparation,
        Tracking,
        Radar,
        Summary
    }
}
