    private async Task StopTrackingAsync()
    {
        if (_controlsBusy) return;
        _controlsBusy = true;
        _pendingQueueCount = TrackingControl.QueueSize;

        if (_pendingQueueCount == 0)
        {
            await StopAndFinalizeAsync(flushQueue: false);
            _controlsBusy = false;
        }
        else if (TrackingControl.FlushOnStop)
        {
            _showFlushChoice = true;
        }
        else
        {
            await StopAndFinalizeAsync(flushQueue: false);
            ShowReplayNotice();
            _controlsBusy = false;
        }
    }

    private async Task StopWithoutFlushAsync()
    {
        _showFlushChoice = false;
        await StopAndFinalizeAsync(flushQueue: false);
        ShowReplayNotice();
        _controlsBusy = false;
    }

    private Task StopWithFlushAsync()
    {
        _showFlushChoice = false;
        _showFlushProgress = true;
        _flushProgress = new BaseStationReader.Entities.Spool.QueueFlushProgress(
            _pendingQueueCount,
            _pendingQueueCount);
        _flushCancellation = new CancellationTokenSource();
        var progress = new FlushProgressReporter();
        var selectedAddress = _selected?.Address;
        _completedAircraft = LiveAircraft.Aircraft.Select(CloneAircraft).ToArray();
        _selected = _completedAircraft.FirstOrDefault(aircraft => aircraft.Address == selectedAddress);

        // Return the click event immediately so Blazor can commit the dialog. The observed workflow
        // then posts each progress value as an independent renderer operation.
        _flushWorkflow = RunFlushWorkflowAsync(progress, _flushCancellation);
        return Task.CompletedTask;
    }

    private async Task RunFlushWorkflowAsync(
        FlushProgressReporter progress,
        CancellationTokenSource flushCancellation)
    {
        await Task.Yield();
        // Keep the potentially synchronous SQLite flush completely off the Blazor dispatcher.
        // Otherwise StopAsync can finish all database work before returning an incomplete Task,
        // leaving the renderer no opportunity to display intermediate progress.
        var stopTask = Task.Run(
            () => TrackingControl.StopAsync(
                flushQueue: true,
                flushCancellation.Token,
                progress),
            CancellationToken.None);

        // Coalesce potentially thousands of per-record reports into a bounded UI cadence. This
        // prevents renderer-queue flooding while still showing meaningful intermediate progress.
        while (!stopTask.IsCompleted)
        {
            await Task.Delay(100).ConfigureAwait(false);
            var snapshot = progress.Latest;
            if (snapshot is not null)
            {
                await InvokeAsync(() =>
                {
                    _flushProgress = snapshot;
                    StateHasChanged();
                });
            }
        }

        var stoppedSuccessfully = false;
        try
        {
            await stopTask.ConfigureAwait(false);
            stoppedSuccessfully = true;
            await InvokeAsync(async () =>
            {
                _profileError = false;
                _profileMessage = null;
                _activeTab = SessionTab.Summary;
                await LoadSummaryAsync();
                SaveCompletedSessionState();
            });
        }
        catch (OperationCanceledException) when (flushCancellation.IsCancellationRequested)
        {
            // Cancellation intentionally leaves the remaining records in the persistent spool.
        }
        catch (Exception exception)
        {
            await InvokeAsync(() =>
            {
                _profileError = true;
                _profileMessage = exception.Message;
            });
        }

        var finalProgress = progress.Latest;
        if (stoppedSuccessfully)
        {
            var initial = finalProgress?.InitialCount ?? _pendingQueueCount;
            finalProgress = new BaseStationReader.Entities.Spool.QueueFlushProgress(initial, 0);
        }
        if (finalProgress is not null)
        {
            await InvokeAsync(() => _flushProgress = finalProgress);
        }
        var remaining = finalProgress?.RemainingCount ?? TrackingControl.QueueSize;
        var cancelled = flushCancellation.IsCancellationRequested && remaining > 0;
        if (stoppedSuccessfully && !cancelled && remaining == 0)
        {
            // A fast flush can start and finish inside one Blazor render window. Paint the completed
            // state before dismissing the dialog so users receive visible confirmation.
            await InvokeAsync(StateHasChanged);
            await Task.Delay(500);
        }

        await InvokeAsync(() =>
        {
            _showFlushProgress = false;
            flushCancellation.Dispose();
            if (ReferenceEquals(_flushCancellation, flushCancellation))
            {
                _flushCancellation = null;
            }
            if (cancelled)
            {
                _replayQueueCount = remaining;
                _showReplayNotice = true;
            }
            _controlsBusy = false;
            StateHasChanged();
        });
    }

    private void CancelFlush() => _flushCancellation?.Cancel();

    private void ShowReplayNotice()
    {
        _replayQueueCount = TrackingControl.QueueSize;
        _showReplayNotice = _replayQueueCount > 0;
    }

    private void CloseReplayNotice() => _showReplayNotice = false;

    private string FlushProgressLabel
    {
        get
        {
            var initial = _flushProgress?.InitialCount ?? _pendingQueueCount;
            var remaining = _flushProgress?.RemainingCount ?? initial;
            if (initial > 0 && remaining == 0)
            {
                return $"Flush complete — {initial:N0} entries written.";
            }
            return $"{Math.Max(0, initial - remaining):N0} of {initial:N0} entries written; {remaining:N0} remaining.";
        }
    }

    private string FlushProgressWidth
        => FlushProgressValue.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private double FlushProgressValue
    {
        get
        {
            var initial = _flushProgress?.InitialCount ?? _pendingQueueCount;
            if (initial <= 0)
            {
                return 100;
            }

            var processed = _flushProgress?.ProcessedCount ?? 0;
            return Math.Clamp(processed * 100d / initial, 0, 100);
        }
    }

    private async Task<bool> StopAndFinalizeAsync(bool flushQueue, CancellationToken cancellationToken = default,
        IProgress<BaseStationReader.Entities.Spool.QueueFlushProgress>? progress = null)
    {
        _profileMessage = null;
        try
        {
            var selectedAddress = _selected?.Address;
            _completedAircraft = LiveAircraft.Aircraft.Select(CloneAircraft).ToArray();
            _selected = _completedAircraft.FirstOrDefault(aircraft => aircraft.Address == selectedAddress);
            await TrackingControl.StopAsync(flushQueue, cancellationToken, progress);
            _profileError = false;
            _activeTab = SessionTab.Summary;
            await LoadSummaryAsync();
            SaveCompletedSessionState();
            return true;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Cancellation intentionally leaves the remaining records in the persistent spool.
            return false;
        }
        catch (Exception exception)
        {
            _profileError = true;
            _profileMessage = exception.Message;
            return false;
        }
    }

    /// <summary>
    /// Copies a live aircraft DTO for the completed-session Tracking view.
    /// </summary>
    /// <param name="aircraft">The final live aircraft state to snapshot.</param>
    /// <returns>An independent DTO containing every value used by the table and detail panel.</returns>
    private static TrackedAircraftDto CloneAircraft(TrackedAircraftDto aircraft)
    {
        // An independent copy cannot be changed when the live SignalR collection is subsequently cleared.
        return new TrackedAircraftDto
        {
            Address = aircraft.Address,
            Callsign = aircraft.Callsign,
            Squawk = aircraft.Squawk,
            Altitude = aircraft.Altitude,
            Behaviour = aircraft.Behaviour,
            GroundSpeed = aircraft.GroundSpeed,
            Track = aircraft.Track,
            Latitude = aircraft.Latitude,
            Longitude = aircraft.Longitude,
            Distance = aircraft.Distance,
            VerticalRate = aircraft.VerticalRate,
            Messages = aircraft.Messages,
            LastSeen = aircraft.LastSeen,
            Status = aircraft.Status
        };
    }

    /// <summary>
    /// Saves the completed session for navigation within the current Blazor UI circuit.
    /// </summary>
    private void SaveCompletedSessionState()
    {
        if (TrackingControl.IsTracking || !_sessionId.HasValue)
        {
            return;
        }

        // Scoped page state survives component navigation but is never written to browser or persistent storage.
        PageState.CompletedLiveTracker = new CompletedLiveTrackerPageState
        {
            SessionId = _sessionId.Value,
            ActiveTab = _activeTab.ToString(),
            MaximumRadarRange = _maximumRadarRange,
            Aircraft = _completedAircraft.Select(CloneAircraft).ToArray()
        };
    }

    /// <summary>
    /// Restores a safe tab for a completed session from circuit-local page state.
    /// </summary>
    /// <param name="tabName">The previously selected tab name.</param>
    /// <returns>The previous completed-session tab, falling back to Tracking.</returns>
    private static SessionTab ParseCompletedSessionTab(string tabName)
    {
        // Only tabs that can represent a completed session may be restored.
        return Enum.TryParse<SessionTab>(tabName, out var tab) &&
            tab is SessionTab.Preparation or SessionTab.Tracking or SessionTab.Radar or SessionTab.PositionDensity or SessionTab.Summary
                ? tab
                : SessionTab.Tracking;
    }

    /// <summary>
    /// Retains a completed session's selected radar range across page navigation.
    /// </summary>
    private void OnRadarRangeChanged()
    {
        // Active sessions remain owned by the runtime; only completed-session UI state needs saving here.
        SaveCompletedSessionState();
    }

    private async Task<int?> WaitForNewSessionIdAsync(int? previousSessionId)
    {
        // Controller startup is long-running; briefly wait for its initial session insert to become visible.
        for (var attempt = 0; attempt < 40; attempt++)
        {
            var sessionId = await SessionQueries.GetLatestSessionIdAsync();
            if (sessionId.HasValue && sessionId != previousSessionId)
            {
                return sessionId;
            }
            await Task.Delay(25);
        }
        return null;
    }

    /// <summary>
    /// Schedules a render when live state changes on a SignalR callback thread.
    /// </summary>
    private void OnLiveStateChanged(object? sender, EventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            if (_activeTab == SessionTab.PositionDensity && TrackingControl.IsTracking)
            {
                PositionDensityOrchestrator.Refresh();
            }
            StateHasChanged();
        });
    }

    /// <summary>
    /// Activates an available session tab and refreshes data-backed tabs on demand.
    /// </summary>
    private async Task SelectTabAsync(SessionTab tab)
    {
        // Every results tab remains available for the represented active or completed session.
        if ((tab == SessionTab.Tracking || tab == SessionTab.Radar || tab == SessionTab.Summary || tab == SessionTab.PositionDensity) && !_sessionStarted)
        {
            return;
        }
        _activeTab = tab;
        if (!TrackingControl.IsTracking)
        {
            SaveCompletedSessionState();
        }
        if (tab == SessionTab.PositionDensity)
        {
            // Every tab entry performs a complete scoped retrieval and recalculation, even within one session.
            await LoadPositionDensityAsync();
        }
        if (tab == SessionTab.Summary && (_summary is null || TrackingControl.IsTracking))
        {
            await LoadSummaryAsync();
        }
    }

    /// <summary>
    /// Recalculates density for the session currently represented by the Live Tracker page.
    /// </summary>
    private async Task LoadPositionDensityAsync()
    {
        var requestedSessionId = _sessionId;
        var requestVersion = Interlocked.Increment(ref _densityRequestVersion);
        _densityCancellation?.Cancel();
        _densityCancellation?.Dispose();
        var cancellation = new CancellationTokenSource();
        _densityCancellation = cancellation;

        if (!requestedSessionId.HasValue)
        {
            // Never infer the latest session here: the plot must follow the page's explicit session identity.
            _densityError = null;
            _densityLoading = false;
            return;
        }

        _densityLoading = true;
        _densityError = null;
        try
        {
            if (TrackingControl.IsTracking)
            {
                PositionDensityOrchestrator.Refresh();
            }
            var result = await SessionQueries.GetPositionDensityAsync(
                requestedSessionId.Value,
                cancellation.Token);

            // A superseded request or session change must not replace the current plot with stale data.
            if (requestVersion != _densityRequestVersion || requestedSessionId != _sessionId)
            {
                return;
            }
            if (result is not null)
            {
                PositionDensitySnapshots.Merge(result);
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            // Cancellation is expected when Refresh or a session transition supersedes this calculation.
        }
        catch (Exception exception)
        {
            if (requestVersion != _densityRequestVersion || requestedSessionId != _sessionId)
            {
                return;
            }
            _densityError = exception.Message;
        }
        finally
        {
            if (requestVersion == _densityRequestVersion)
            {
                _densityLoading = false;
            }
        }
    }

    /// <summary>
    /// Clears density state and invalidates any calculation associated with the previous session.
    /// </summary>
    private void ClearPositionDensity()
    {
        // Increment before cancellation so even a provider that ignores cancellation cannot publish stale results.
        Interlocked.Increment(ref _densityRequestVersion);
        _densityCancellation?.Cancel();
        _densityError = null;
        _densityLoading = false;
    }

    private string TabClass(SessionTab tab) => _activeTab == tab ? "active" : string.Empty;

    private async Task LoadSummaryAsync()
    {
        if (!_sessionStarted || _summaryLoading)
        {
            return;
        }
        _summaryLoading = true;
        _summaryError = null;
        _status = null;
        ClearPositionDensity();
        try
        {
            _summary = _sessionId.HasValue
                ? await SessionQueries.GetObservationSessionSummaryAsync(_sessionId.Value)
                : null;

            // Refresh operational tracking counters alongside the persisted Summary snapshot.
            _status = await LiveStatus.GetAsync(
                _sessionId,
                LiveAircraft.Aircraft,
                TrackingControl.IsTracking);
        }
        catch (Exception exception)
        {
            _summaryError = exception.Message;
        }
        finally
        {
            _summaryLoading = false;
        }
    }

    /// <summary>
    /// Returns the Live Tracker workflow to editable session preparation.
    /// </summary>
    private void PrepareNewSession()
    {
        // Reset both persisted-summary and operational-status views before accepting new session details.
        if (TrackingControl.IsTracking)
        {
            return;
        }
        _sessionStarted = false;
        _sessionId = null;
        _summary = null;
        _summaryError = null;
        _status = null;
        _completedAircraft = [];
        _selectedEquipment = [];
        PageState.CompletedLiveTracker = null;
        _sessionName = string.Empty;
        _sessionNotes = string.Empty;
        _profileMessage = null;
        _activeTab = SessionTab.Preparation;
    }

    /// <summary>
    /// Combines persisted Summary measures with operational tracking counters.
    /// </summary>
    private static IReadOnlyList<StatusMetric> SummaryTrackingMetrics(
        ObservationSessionSummary summary,
        LiveTrackerStatus? status)
    {
        // Prefer the monotonic operational value for the overlapping position-record measure.
        var metrics = new List<StatusMetric>();

        if (status is null)
        {
            // Retain persisted distinct and position totals if operational state is temporarily unavailable.
            metrics.Add(new StatusMetric("Aircraft", summary.DistinctAircraft));
            metrics.Add(new StatusMetric("With positions", summary.AircraftWithPositionHistory));
            metrics.Add(new StatusMetric("Position records", summary.PositionRecords));
            metrics.Add(new StatusMetric("Callsigns", summary.DistinctCallsigns));
            return metrics;
        }

        metrics.Add(new StatusMetric("Aircraft", status.DistinctAircraft));
        metrics.Add(new StatusMetric("Currently tracked", status.CurrentlyTracked));
        metrics.Add(new StatusMetric("With positions", status.AircraftWithPositionRecords));
        metrics.Add(new StatusMetric("Position records", status.PositionRecords));
        metrics.Add(new StatusMetric("Callsigns", status.DistinctCallsigns));
        metrics.Add(new StatusMetric("Messages processed", status.MessagesProcessed));
        return metrics;
    }

    /// <summary>
    /// Returns local aircraft reference resolution metrics.
    /// </summary>
    private static IReadOnlyList<StatusMetric> LocalIdentificationMetrics(LiveTrackerStatus status)
    {
        // Split every current ICAO identity into mutually exclusive resolved and unresolved groups.
        return [new("Aircraft locally resolved", status.AircraftLocallyResolved), new("Aircraft unresolved", status.AircraftUnresolved)];
    }

    /// <summary>
    /// Returns local flight mapping resolution metrics.
    /// </summary>
    private static IReadOnlyList<StatusMetric> FlightIdentificationMetrics(LiveTrackerStatus status)
    {
        // Keep missing callsigns separate because they cannot participate in flight mapping.
        return
        [
            new("Flights locally resolved", status.FlightsLocallyResolved),
            new("Flights unresolved", status.FlightsUnresolved),
            new("Aircraft without callsign", status.AircraftWithoutCallsign)
        ];
    }

    /// <summary>
    /// Returns successful API resolutions still present in the transient cache.
    /// </summary>
    private static IReadOnlyList<StatusMetric> TransientLookupMetrics(LiveTrackerStatus status)
    {
        // These values describe process-memory results only and never imply local persistence.
        return [new("Aircraft transiently resolved", status.AircraftTransientlyResolved), new("Flights transiently resolved", status.FlightsTransientlyResolved)];
    }

    private static IEnumerable<(string Label, ObservationHighlight? Item, string Value)> Highlights(ObservationSessionSummary summary) =>
    [
        ("Lowest altitude", summary.LowestAltitude, FormatHighlightAltitude(summary.LowestAltitude)),
        ("Highest altitude", summary.HighestAltitude, FormatHighlightAltitude(summary.HighestAltitude)),
        ("Furthest aircraft", summary.FurthestAircraft, FormatHighlightDistance(summary.FurthestAircraft)),
        ("Longest observed", summary.LongestObservedAircraft, FormatHighlightDuration(summary.LongestObservedAircraft))
    ];

    private static string DisplayAircraft(ObservationHighlight item)
        => string.IsNullOrWhiteSpace(item.Callsign) ? item.Address : $"{item.Callsign} · {item.Address}";

    private static string FormatUtcTimestamp(DateTime value)
        => DateTime.SpecifyKind(value, DateTimeKind.Utc).ToLocalTime().ToString("dd MMM yyyy · HH:mm:ss");

    private static string FormatLocalTimestamp(DateTime? value)
        => value?.ToString("dd MMM yyyy · HH:mm:ss") ?? "No activity recorded";

    /// <summary>Uses live feed activity while a session is running, then falls back to persisted history.</summary>
    private DateTime? EffectiveLastActivity(ObservationSessionSummary summary)
        => TrackingControl.IsTracking && TrackingControl.LastActivityUtc.HasValue
            ? DateTime.SpecifyKind(TrackingControl.LastActivityUtc.Value, DateTimeKind.Utc).ToLocalTime()
            : summary.LastActivity;

    /// <summary>Derives the active duration from live message activity without changing completed summaries.</summary>
    private TimeSpan EffectiveObservedDuration(ObservationSessionSummary summary)
    {
        if (!TrackingControl.IsTracking || !TrackingControl.LastActivityUtc.HasValue)
        {
            return summary.ObservedDuration;
        }

        var startedAtUtc = DateTime.SpecifyKind(summary.StartedAtUtc, DateTimeKind.Utc);
        var duration = TrackingControl.LastActivityUtc.Value - startedAtUtc;
        return duration < TimeSpan.Zero ? TimeSpan.Zero : duration;
    }

    private static string FormatDuration(TimeSpan duration)
        => duration.TotalHours >= 1
            ? $"{(int)duration.TotalHours}h {duration.Minutes}m {duration.Seconds}s"
            : duration.TotalMinutes >= 1 ? $"{duration.Minutes}m {duration.Seconds}s" : $"{Math.Max(0, duration.Seconds)}s";

    private static string FormatLocation(ObservationSessionSummary summary)
        => summary.ReceiverLatitude.HasValue && summary.ReceiverLongitude.HasValue
            ? $"{summary.ReceiverLatitude:F6}, {summary.ReceiverLongitude:F6}" +
              (summary.ReceiverElevation.HasValue ? $" · {summary.ReceiverElevation:N0} ft" : string.Empty)
            : "Not configured";

    private static string FormatLimits(ObservationSessionSummary summary)
    {
        var altitude = summary.MinimumAltitudeLimit.HasValue || summary.MaximumAltitudeLimit.HasValue
            ? $"{summary.MinimumAltitudeLimit?.ToString("N0") ?? "Any"}–{summary.MaximumAltitudeLimit?.ToString("N0") ?? "Any"} ft"
            : "Any altitude";
        var distance = summary.MaximumDistanceLimit.HasValue
            ? $"within {summary.MaximumDistanceLimit:N0} nm"
            : "any distance";
        return $"{altitude} · {distance}";
    }

    private static string FormatHighlightAltitude(ObservationHighlight? item)
        => item?.Altitude is decimal value ? $"{value:N0} ft" : "—";

    private static string FormatHighlightDistance(ObservationHighlight? item)
        => item?.Distance is double value ? $"{value:N1} nm" : "—";

    private static string FormatHighlightDuration(ObservationHighlight? item)
        => item?.Duration is TimeSpan value ? FormatDuration(value) : "—";

    /// <summary>
    /// Selects an aircraft for the detail panel.
    /// </summary>
    private void SelectAircraft(TrackedAircraftDto aircraft)
    {
        // Retain the latest DTO; subsequent events refresh it through the render lookup.
        _selected = aircraft;
    }

    /// <summary>
    /// Closes the selected-aircraft detail panel.
    /// </summary>
    private void ClearSelection()
    {
        // Removing the reference is enough to hide the conditional panel.
        _selected = null;
    }

    /// <summary>
    /// Changes the active table sort or reverses its direction.
    /// </summary>
    private void SortBy(SortColumn column)
    {
        // Repeated clicks toggle direction; a new column starts ascending.
        _ascending = _sortColumn == column ? !_ascending : true;
        _sortColumn = column;
    }

    /// <summary>
    /// Returns the direction marker for a sortable column.
    /// </summary>
    private string SortIndicator(SortColumn column)
    {
        // Leave inactive headings unadorned to reduce visual noise.
        return _sortColumn == column ? (_ascending ? "↑" : "↓") : string.Empty;
    }

    /// <summary>
    /// Returns a CSS class matching an aircraft tracking status.
    /// </summary>
    private static string StatusClass(TrackingStatus status)
    {
        // Enum names map directly to the status colour tokens in the stylesheet.
        return status.ToString().ToLowerInvariant();
    }

    /// <summary>
    /// Marks the currently selected table row.
    /// </summary>
    private string SelectedClass(TrackedAircraftDto aircraft)
    {
        // ICAO address provides stable selection as DTO instances are replaced by updates.
        return _selected?.Address == aircraft.Address ? "selected" : string.Empty;
    }

    /// <summary>
    /// Converts aircraft behaviour to a compact directional indicator.
    /// </summary>
    private static string BehaviourIndicator(AircraftBehaviour behaviour)
    {
        // Match the familiar indicators used by the console tracker.
        return behaviour switch
        {
            AircraftBehaviour.Climbing => "↑",
            AircraftBehaviour.Descending => "↓",
            AircraftBehaviour.LevelFlight => "→",
            _ => "·"
        };
    }

    /// <summary>
    /// Formats a nullable numeric value and optional unit.
    /// </summary>
    private static string FormatNumber<T>(T? value, string format, string unit = "") where T : struct, IFormattable
    {
        // Use an em dash for unavailable telemetry rather than suggesting a zero value.
        return value.HasValue ? $"{value.Value.ToString(format, null)}{unit}" : "—";
    }

    /// <summary>
    /// Returns a non-empty display string.
    /// </summary>
    private static string Display(string? value)
    {
        // Callsigns and squawks can legitimately be absent from partial messages.
        return string.IsNullOrWhiteSpace(value) ? "—" : value;
    }

    /// <summary>
    /// Formats the most recent service update as local time.
    /// </summary>
    private static string FormatUpdated(DateTimeOffset? updated)
    {
        // Keep the dashboard compact while preserving second-level precision.
        return updated?.ToLocalTime().ToString("HH:mm:ss") ?? "No updates yet";
    }

    /// <summary>
    /// Describes how long ago the latest live update arrived.
    /// </summary>
    private static string FormatUpdateAge(DateTimeOffset? updated)
    {
        // Exact age continually changes, so communicate the known timestamp's date instead.
        return updated.HasValue ? updated.Value.ToLocalTime().ToString("dd MMM yyyy") : "waiting for tracker data";
    }

    private enum SortColumn
    {
        Arrival,
        Address,
        Callsign,
        Altitude,
        Distance,
        LastSeen
    }

    private enum SessionTab
    {
        Preparation,
        Tracking,
        Radar,
        PositionDensity,
        Summary
    }

    /// <summary>
    /// Retains the latest writer progress for the bounded UI render loop.
    /// </summary>
    private sealed class FlushProgressReporter :
        IProgress<BaseStationReader.Entities.Spool.QueueFlushProgress>
    {
        private BaseStationReader.Entities.Spool.QueueFlushProgress? _latest;

        public BaseStationReader.Entities.Spool.QueueFlushProgress? Latest
            => Volatile.Read(ref _latest);

        public void Report(BaseStationReader.Entities.Spool.QueueFlushProgress value)
            => Volatile.Write(ref _latest, value);
    }
}
