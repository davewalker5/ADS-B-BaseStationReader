            _sessionId = await SessionQueries.GetLatestSessionIdAsync();
            await LoadSessionEquipmentAsync();
            _activeTab = RequestedTab?.Equals("radar", StringComparison.OrdinalIgnoreCase) == true
                ? SessionTab.Radar
