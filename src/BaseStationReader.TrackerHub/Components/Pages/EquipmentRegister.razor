@page "/history/equipment"
@inject IEquipmentRegisterService EquipmentService

<PageTitle>Equipment · Database · ADS-B Tracker</PageTitle>
<DatabaseTabs />

<section class="filter-panel">
    <div class="filter-heading"><div><h2>Equipment filter</h2><p>Search by name and equipment type.</p></div></div>
    <form @onsubmit="LoadEquipmentAsync" @onsubmit:preventDefault><div class="filter-grid">
        <label><span>Name</span><input @bind="_filter" autocomplete="off" /></label>
        <label><span>Type</span><select @bind="_filterTypeId"><option value="0">All types</option>@foreach (var type in _types) { <option value="@type.Id">@type.Name</option> }</select></label>
    </div><div class="filter-actions"><button class="primary-button" type="submit" disabled="@_busy">Search</button><button class="secondary-button" type="button" @onclick="ClearFilterAsync">Clear</button></div></form>
</section>

@if (_error is not null) { <div class="alert" role="alert"><strong>Operation failed</strong><span>@_error</span></div> }

<section class="tracker-panel history-panel" aria-busy="@_busy">
    <div class="panel-heading"><div><h2>Equipment</h2><p>@_results.Count matching items</p></div><button class="primary-button" @onclick="Add" disabled="@(_types.Count == 0)">Add</button></div>
    <div class="table-wrap"><table><thead><tr><th>Name</th><th>Type</th><th>Actions</th></tr></thead><tbody>
        @if (_results.Count == 0) { <tr><td colspan="3" class="table-empty">No equipment matches this filter.</td></tr> }
        @foreach (var item in _results) { <tr><td><strong>@item.Name</strong></td><td>@item.EquipmentType.Name</td><td><button class="edit-button" type="button" title="Edit equipment" aria-label="Edit equipment @item.Name" @onclick="() => Edit(item)"><span aria-hidden="true">✏️</span></button> <button class="session-delete-button" aria-label="Delete @item.Name" @onclick="() => DeleteAsync(item)">🗑️</button></td></tr> }
    </tbody></table></div>
</section>

@if (_editing is not null)
{
    <section class="provenance-editor"><div><h2>@(_editing.Id == 0 ? "Add equipment" : "Edit equipment")</h2></div>
        <EditForm Model="_editing" OnValidSubmit="SaveAsync" FormName="equipment-editor"><DataAnnotationsValidator /><div class="provenance-fields">
            <label><span>Name</span><InputText @bind-Value="_editing.Name" /></label>
            <label><span>Type</span><InputSelect @bind-Value="_editing.EquipmentTypeId"><option value="0">Select type</option>@foreach (var type in _types) { <option value="@type.Id">@type.Name</option> }</InputSelect></label>
        </div><ValidationSummary /><div class="provenance-editor-actions"><button class="primary-button" type="submit" disabled="@(_busy || _editing.EquipmentTypeId == 0)">Save</button><button class="secondary-button" type="button" @onclick="Cancel">Cancel</button></div></EditForm>
    </section>
}

@code {
#nullable enable
    private IReadOnlyList<Equipment> _results = [];
    private IReadOnlyList<EquipmentType> _types = [];
    private Equipment? _editing;
    private string _filter = "";
    private int _filterTypeId;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync() { _types = await EquipmentService.SearchTypesAsync(null); await LoadEquipmentAsync(); }
    private async Task LoadEquipmentAsync() { _busy = true; _error = null; try { _results = await EquipmentService.SearchEquipmentAsync(_filter, _filterTypeId == 0 ? null : _filterTypeId); } catch (Exception exception) { _error = exception.Message; } finally { _busy = false; } }
    private async Task ClearFilterAsync() { _filter = ""; _filterTypeId = 0; await LoadEquipmentAsync(); }
    private void Add() => _editing = new();
    private void Edit(Equipment item) => _editing = new() { Id = item.Id, Name = item.Name, EquipmentTypeId = item.EquipmentTypeId };
    private void Cancel() => _editing = null;
    private async Task SaveAsync() { if (_editing is null) return; _busy = true; try { await EquipmentService.SaveEquipmentAsync(_editing); _editing = null; await LoadEquipmentAsync(); } catch (Exception exception) { _error = exception.Message; } finally { _busy = false; } }
    private async Task DeleteAsync(Equipment item) { _busy = true; try { await EquipmentService.DeleteEquipmentAsync(item.Id); if (_editing?.Id == item.Id) _editing = null; await LoadEquipmentAsync(); } catch (Exception exception) { _error = exception.Message; } finally { _busy = false; } }
}
