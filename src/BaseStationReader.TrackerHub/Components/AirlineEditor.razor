@inject IAirlineReferenceService AirlineService
@inject IProvenanceService ProvenanceService
@inject ITrackingControlService TrackingControl

<section class="aircraft-panel">
    <div class="aircraft-filter airline-filter">
        <label><span>IATA code</span><InputText @bind-Value="_iata" /></label>
        <label><span>ICAO code</span><InputText @bind-Value="_icao" /></label>
        <label><span>Name</span><InputText @bind-Value="_name" /></label>
        <button class="primary-button" type="button" @onclick="FindAsync" disabled="@_loading">
            @(_loading ? "Searching…" : "Find airlines")
        </button>
    </div>

    <div class="table-wrap provenance-table-wrap aircraft-table-wrap">
        <table>
            <thead><tr><th>IATA</th><th>ICAO</th><th>Name</th><th>Provenance</th><th>Delete</th></tr></thead>
            <tbody>
                @if (_loading)
                {
                    <tr><td colspan="5" class="table-empty">Searching airlines…</td></tr>
                }
                else if (!_searchPerformed)
                {
                    <tr><td colspan="5" class="table-empty">Enter an IATA code, ICAO code, or airline name to find airlines.</td></tr>
                }
                else if (_airlines.Count == 0)
                {
                    <tr><td colspan="5" class="table-empty">No airlines matched those filters.</td></tr>
                }
                else
                {
                    @foreach (var airline in _airlines)
                    {
                        <tr class="@(airline.Id == _editModel.Id ? "selected" : null)" tabindex="0"
                            @onclick="() => Edit(airline)" @onkeydown="args => SelectFromKeyboard(args, airline)">
                            <td><strong>@airline.IATA</strong></td>
                            <td><strong>@airline.ICAO</strong></td>
                            <td>@airline.Name</td>
                            <td>@airline.Provenance?.SourceRef</td>
                            <td class="session-delete-action" @onclick:stopPropagation="true">
                                <button class="session-delete-button" type="button"
                                        disabled="@(TrackingControl.IsTracking || _saving)"
                                        title="@(TrackingControl.IsTracking ? "Airline deletion is unavailable while a session is active" : "Delete airline")"
                                        aria-label="Delete airline @airline.Name"
                                        @onclick="() => ConfirmDelete(airline)">
                                    <span aria-hidden="true">🗑️</span>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="provenance-editor">
        <div>
            <h2>@(_editModel.Id == 0 ? "Add airline" : "Edit airline")</h2>
            <p>@(_editModel.Id == 0 ? "Create a new airline record." : $"Editing {_editModel.Name}.")</p>
        </div>
        <EditForm Model="_editModel" OnValidSubmit="SaveAsync" FormName="airline-editor">
            <DataAnnotationsValidator />
            <div class="provenance-fields">
                <label><span>IATA code</span><InputText @bind-Value="_editModel.IATA" disabled="@(!CanEdit)" /></label>
                <label><span>ICAO code</span><InputText @bind-Value="_editModel.ICAO" disabled="@(!CanEdit)" /></label>
                <label><span>Name</span><InputText @bind-Value="_editModel.Name" disabled="@(!CanEdit)" /></label>
                <label>
                    <span>Provenance</span>
                    <InputSelect @bind-Value="_editModel.ProvenanceId" disabled="@(!CanEdit)">
                        <option value="0">Select provenance</option>
                        @foreach (var provenance in _provenance)
                        {
                            <option value="@provenance.Id">@provenance.SourceRef - @provenance.Source</option>
                        }
                    </InputSelect>
                </label>
            </div>
            <ValidationSummary />
            @if (TrackingControl.IsTracking)
            {
                <p class="editor-read-only">Airlines cannot be changed while a live tracking session is active.</p>
            }
            <div class="provenance-editor-actions">
                <button class="primary-button" type="submit" disabled="@(!CanEdit)">Save airline</button>
                <button class="secondary-button" type="button" @onclick="Clear" disabled="@_saving">Clear</button>
            </div>
        </EditForm>
    </div>
</section>

@if (_deleteModel is not null)
{
    <div class="modal-backdrop" @onclick="CloseDelete">
        <section class="confirmation-modal" role="dialog" aria-modal="true" aria-labelledby="delete-airline-title"
                 tabindex="0" @onclick:stopPropagation @onkeydown="HandleDeleteKeyDown">
            <header>
                <div>
                    <p class="eyebrow">Permanent deletion</p>
                    <h2 id="delete-airline-title">Delete airline?</h2>
                </div>
                <button class="icon-button" type="button" aria-label="Close delete confirmation"
                        autofocus @onclick="CloseDelete" disabled="@_saving">×</button>
            </header>
            <p>This will permanently delete airline <strong>@_deleteModel.Name</strong>
                (@DisplayCodes(_deleteModel)).</p>
            @if (_deleteError is not null)
            {
                <div class="alert" role="alert"><strong>Airline deletion failed</strong><span>@_deleteError</span></div>
            }
            <div class="confirmation-actions">
                <button class="secondary-button" type="button" @onclick="CloseDelete" disabled="@_saving">Cancel</button>
                <button class="danger-button" type="button" @onclick="DeleteAsync"
                        disabled="@(_saving || TrackingControl.IsTracking)">
                    @(_saving ? "Deleting…" : "Delete airline")
                </button>
            </div>
        </section>
    </div>
}

@if (_error is not null) { <div class="alert" role="alert"><strong>Operation failed</strong><span>@_error</span></div> }
@if (_success is not null) { <div class="import-success" role="status"><strong>Complete</strong><span>@_success</span></div> }

@code {
#nullable enable
    private string _iata = "";
    private string _icao = "";
    private string _name = "";
    private bool _loading;
    private bool _saving;
    private bool _searchPerformed;
    private string? _error;
    private string? _success;
    private string? _deleteError;
    private List<Airline> _airlines = [];
    private List<Provenance> _provenance = [];
    private Airline _editModel = new();
    private Airline? _deleteModel;
    private bool CanEdit => !_saving && !TrackingControl.IsTracking;

    protected override async Task OnInitializedAsync()
    {
        try { _provenance = (await ProvenanceService.ListAsync()).OrderBy(x => x.SourceRef).ToList(); }
        catch (Exception exception) { _error = exception.Message; }
    }

    private async Task FindAsync()
    {
        if (string.IsNullOrWhiteSpace(_iata) &&
            string.IsNullOrWhiteSpace(_icao) &&
            string.IsNullOrWhiteSpace(_name))
        {
            _airlines = [];
            _searchPerformed = false;
            _error = "Enter an IATA code, ICAO code, or airline name before searching.";
            _success = null;
            return;
        }

        _loading = true; _searchPerformed = true; _error = null; _success = null;
        try
        {
            _airlines = (await AirlineService.FindAsync(_iata, _icao, _name))
                .OrderBy(x => x.Name).ToList();
            Clear();
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _loading = false; }
    }

    private void Edit(Airline airline) => _editModel = Copy(airline);
    private void SelectFromKeyboard(KeyboardEventArgs args, Airline airline)
    {
        if (args.Key is "Enter" or " ")
        {
            Edit(airline);
        }
    }

    private void Clear() => _editModel = new();

    private async Task SaveAsync()
    {
        if (!CanEdit)
        {
            return;
        }
        _saving = true; _error = null; _success = null;
        try
        {
            var isNew = _editModel.Id == 0;
            var saved = await AirlineService.SaveAsync(_editModel);
            if (string.IsNullOrWhiteSpace(_iata) &&
                string.IsNullOrWhiteSpace(_icao) &&
                string.IsNullOrWhiteSpace(_name))
            {
                if (!string.IsNullOrWhiteSpace(saved.ICAO))
                {
                    _icao = saved.ICAO;
                }
                else if (!string.IsNullOrWhiteSpace(saved.IATA))
                {
                    _iata = saved.IATA;
                }
                else
                {
                    _name = saved.Name;
                }
            }
            await FindAsync();
            _success = isNew ? "Airline record added." : "Airline record updated.";
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _saving = false; }
    }

    private void ConfirmDelete(Airline airline)
    {
        if (_saving || TrackingControl.IsTracking)
        {
            return;
        }
        _deleteModel = Copy(airline);
        _deleteError = null;
    }

    private void CloseDelete()
    {
        if (_saving)
        {
            return;
        }
        _deleteModel = null;
        _deleteError = null;
    }

    private async Task DeleteAsync()
    {
        if (_deleteModel is null || TrackingControl.IsTracking)
        {
            return;
        }
        _saving = true; _error = null; _success = null;
        try
        {
            await AirlineService.DeleteAsync(_deleteModel.Id);
            _deleteModel = null;
            await FindAsync();
            _success = "Airline record deleted.";
        }
        catch (Exception exception) { _deleteError = exception.Message; }
        finally { _saving = false; }
    }

    private void HandleDeleteKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseDelete();
        }
    }

    private static Airline Copy(Airline source) => new()
    {
        Id = source.Id, IATA = source.IATA, ICAO = source.ICAO,
        Name = source.Name, ProvenanceId = source.ProvenanceId
    };

    private static string DisplayCodes(Airline airline)
        => string.Join(" / ", new[] { airline.IATA, airline.ICAO }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
