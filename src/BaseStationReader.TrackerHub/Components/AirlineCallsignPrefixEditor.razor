@inject IAirlineCallsignPrefixReferenceService PrefixService
@inject IAirlineReferenceService AirlineService
@inject IProvenanceService ProvenanceService
@inject ITrackingControlService TrackingControl

<section class="aircraft-panel">
    <div class="aircraft-filter airline-filter">
        <label><span>Callsign prefix</span><InputText @bind-Value="_prefix" /></label>
        <label><span>Airline ICAO</span><InputText @bind-Value="_airlineIcao" /></label>
        <label><span>Airline name</span><InputText @bind-Value="_airlineName" /></label>
        <button class="primary-button" type="button" @onclick="FindAsync" disabled="@_loading">
            @(_loading ? "Searching…" : "Find prefixes")
        </button>
    </div>

    <div class="table-wrap provenance-table-wrap aircraft-table-wrap">
        <table>
            <thead><tr><th>Prefix</th><th>Airline ICAO</th><th>Airline</th><th>Provenance</th><th>Delete</th></tr></thead>
            <tbody>
                @if (_loading)
                {
                    <tr><td colspan="5" class="table-empty">Searching airline prefixes…</td></tr>
                }
                else if (!_searchPerformed)
                {
                    <tr><td colspan="5" class="table-empty">Enter a callsign prefix, airline ICAO code, or airline name to find mappings.</td></tr>
                }
                else if (_mappings.Count == 0)
                {
                    <tr><td colspan="5" class="table-empty">No airline prefix mappings matched those filters.</td></tr>
                }
                else
                {
                    @foreach (var mapping in _mappings)
                    {
                        <tr class="@(mapping.Id == _editModel.Id ? "selected" : null)" tabindex="0"
                            @onclick="() => Edit(mapping)" @onkeydown="args => SelectFromKeyboard(args, mapping)">
                            <td><strong>@mapping.Prefix</strong></td>
                            <td><strong>@mapping.Airline?.ICAO</strong></td>
                            <td>@mapping.Airline?.Name</td>
                            <td>@mapping.Provenance?.SourceRef</td>
                            <td class="session-delete-action" @onclick:stopPropagation="true">
                                <button class="session-delete-button" type="button"
                                        disabled="@(TrackingControl.IsTracking || _saving)"
                                        title="@(TrackingControl.IsTracking ? "Prefix deletion is unavailable while a session is active" : "Delete airline prefix")"
                                        aria-label="Delete callsign prefix @mapping.Prefix"
                                        @onclick="() => ConfirmDelete(mapping)">
                                    <span aria-hidden="true">🗑️</span>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="provenance-editor">
        <div>
            <h2>@(_editModel.Id == 0 ? "Add airline prefix" : "Edit airline prefix")</h2>
            <p>@(_editModel.Id == 0 ? "Create a new callsign-prefix mapping." : $"Editing {_editModel.Prefix}.")</p>
        </div>
        <EditForm Model="_editModel" OnValidSubmit="SaveAsync" FormName="airline-prefix-editor">
            <DataAnnotationsValidator />
            <div class="provenance-fields">
                <label><span>Callsign prefix</span><InputText @bind-Value="_editModel.Prefix" disabled="@(!CanEdit)" /></label>
                <label>
                    <span>Airline</span>
                    <InputSelect @bind-Value="_editModel.AirlineId" disabled="@(!CanEdit)">
                        <option value="0">Select an airline</option>
                        @foreach (var airline in _airlines)
                        {
                            <option value="@airline.Id">@airline.ICAO - @airline.Name</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <span>Provenance</span>
                    <InputSelect @bind-Value="_editModel.ProvenanceId" disabled="@(!CanEdit)">
                        <option value="0">Select provenance</option>
                        @foreach (var provenance in _provenance)
                        {
                            <option value="@provenance.Id">@provenance.SourceRef - @provenance.Source</option>
                        }
                    </InputSelect>
                </label>
            </div>
            <ValidationSummary />
            @if (TrackingControl.IsTracking)
            {
                <p class="editor-read-only">Airline prefix mappings cannot be changed while a live tracking session is active.</p>
            }
            <div class="provenance-editor-actions">
                <button class="primary-button" type="submit" disabled="@(!CanEdit)">Save airline prefix</button>
                <button class="secondary-button" type="button" @onclick="Clear" disabled="@_saving">Clear</button>
            </div>
        </EditForm>
    </div>
</section>

@if (_deleteModel is not null)
{
    <div class="modal-backdrop" @onclick="CloseDelete">
        <section class="confirmation-modal" role="dialog" aria-modal="true" aria-labelledby="delete-airline-prefix-title"
                 tabindex="0" @onclick:stopPropagation @onkeydown="HandleDeleteKeyDown">
            <header>
                <div>
                    <p class="eyebrow">Permanent deletion</p>
                    <h2 id="delete-airline-prefix-title">Delete airline prefix?</h2>
                </div>
                <button class="icon-button" type="button" aria-label="Close delete confirmation"
                        autofocus @onclick="CloseDelete" disabled="@_saving">×</button>
            </header>
            <p>This will permanently delete callsign prefix <strong>@_deleteModel.Prefix</strong>
                for <strong>@_deleteModel.Airline?.Name</strong>.</p>
            @if (_deleteError is not null)
            {
                <div class="alert" role="alert"><strong>Airline prefix deletion failed</strong><span>@_deleteError</span></div>
            }
            <div class="confirmation-actions">
                <button class="secondary-button" type="button" @onclick="CloseDelete" disabled="@_saving">Cancel</button>
                <button class="danger-button" type="button" @onclick="DeleteAsync"
                        disabled="@(_saving || TrackingControl.IsTracking)">
                    @(_saving ? "Deleting…" : "Delete airline prefix")
                </button>
            </div>
        </section>
    </div>
}

@if (_error is not null) { <div class="alert" role="alert"><strong>Operation failed</strong><span>@_error</span></div> }
@if (_success is not null) { <div class="import-success" role="status"><strong>Complete</strong><span>@_success</span></div> }

@code {
#nullable enable
    private string _prefix = "";
    private string _airlineIcao = "";
    private string _airlineName = "";
    private bool _loading;
    private bool _saving;
    private bool _searchPerformed;
    private string? _error;
    private string? _success;
    private string? _deleteError;
    private List<AirlineCallsignPrefix> _mappings = [];
    private List<Airline> _airlines = [];
    private List<Provenance> _provenance = [];
    private AirlineCallsignPrefix _editModel = new();
    private AirlineCallsignPrefix? _deleteModel;
    private bool CanEdit => !_saving && !TrackingControl.IsTracking;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _airlines = (await AirlineService.FindAsync(null, null, null))
                .Where(x => !string.IsNullOrWhiteSpace(x.ICAO))
                .OrderBy(x => x.ICAO).ThenBy(x => x.Name).ToList();
            _provenance = (await ProvenanceService.ListAsync()).OrderBy(x => x.SourceRef).ToList();
        }
        catch (Exception exception) { _error = exception.Message; }
    }

    private async Task FindAsync()
    {
        if (string.IsNullOrWhiteSpace(_prefix) &&
            string.IsNullOrWhiteSpace(_airlineIcao) &&
            string.IsNullOrWhiteSpace(_airlineName))
        {
            _mappings = [];
            _searchPerformed = false;
            _error = "Enter a callsign prefix, airline ICAO code, or airline name before searching.";
            _success = null;
            return;
        }

        _loading = true; _searchPerformed = true; _error = null; _success = null;
        try
        {
            _mappings = (await PrefixService.FindAsync(_prefix, _airlineIcao, _airlineName))
                .OrderBy(x => x.Prefix).ToList();
            Clear();
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _loading = false; }
    }

    private void Edit(AirlineCallsignPrefix mapping) => _editModel = Copy(mapping);
    private void SelectFromKeyboard(KeyboardEventArgs args, AirlineCallsignPrefix mapping)
    {
        if (args.Key is "Enter" or " ")
        {
            Edit(mapping);
        }
    }

    private void Clear() => _editModel = new();

    private async Task SaveAsync()
    {
        if (!CanEdit)
        {
            return;
        }
        _saving = true; _error = null; _success = null;
        try
        {
            var isNew = _editModel.Id == 0;
            var saved = await PrefixService.SaveAsync(_editModel);
            if (string.IsNullOrWhiteSpace(_prefix) &&
                string.IsNullOrWhiteSpace(_airlineIcao) &&
                string.IsNullOrWhiteSpace(_airlineName))
            {
                _prefix = saved.Prefix;
            }
            await FindAsync();
            _success = isNew ? "Airline prefix mapping added." : "Airline prefix mapping updated.";
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _saving = false; }
    }

    private void ConfirmDelete(AirlineCallsignPrefix mapping)
    {
        if (_saving || TrackingControl.IsTracking)
        {
            return;
        }
        _deleteModel = Copy(mapping);
        _deleteError = null;
    }

    private void CloseDelete()
    {
        if (_saving)
        {
            return;
        }
        _deleteModel = null;
        _deleteError = null;
    }

    private async Task DeleteAsync()
    {
        if (_deleteModel is null || TrackingControl.IsTracking)
        {
            return;
        }
        _saving = true; _error = null; _success = null;
        try
        {
            await PrefixService.DeleteAsync(_deleteModel.Id);
            _deleteModel = null;
            await FindAsync();
            _success = "Airline prefix mapping deleted.";
        }
        catch (Exception exception) { _deleteError = exception.Message; }
        finally { _saving = false; }
    }

    private void HandleDeleteKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseDelete();
        }
    }

    private static AirlineCallsignPrefix Copy(AirlineCallsignPrefix source) => new()
    {
        Id = source.Id,
        Prefix = source.Prefix,
        AirlineId = source.AirlineId,
        Airline = source.Airline,
        ProvenanceId = source.ProvenanceId,
        Provenance = source.Provenance
    };
}
