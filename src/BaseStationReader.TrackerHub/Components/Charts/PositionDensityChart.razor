@using System.Globalization

<section class="density-chart-card" aria-label="Recorded position density">
    <div class="density-chart-meta">
        <span><strong>@Density.PositionCount.ToString("N0")</strong> positions</span>
        <span><strong>@Density.Bins.Count.ToString("N0")</strong> occupied bins</span>
        <span><strong>@Density.MaximumBinCount.ToString("N0")</strong> peak density</span>
    </div>
    <div class="density-chart-scroll">
        <svg xmlns="http://www.w3.org/2000/svg" class="density-chart" viewBox="0 0 920 500"
             role="img" aria-labelledby="@_titleId @_descriptionId">
            <title id="@_titleId">Recorded position density for session @Density.SessionId</title>
            <desc id="@_descriptionId">A geographic hexagonal density plot of @Density.PositionCount persisted positions. Brighter bins contain more observations.</desc>

            @foreach (var tick in _latitudeTicks)
            {
                <g>
                    <line class="chart-grid" x1="82" y1="@Format(tick.Position)" x2="895" y2="@Format(tick.Position)" />
                    <text class="chart-tick y" x="72" y="@Format(tick.Position + 4)">@tick.Label</text>
                </g>
            }
            @foreach (var tick in _longitudeTicks)
            {
                <g>
                    <line class="chart-grid vertical" x1="@Format(tick.Position)" y1="20" x2="@Format(tick.Position)" y2="430" />
                    <text class="chart-tick" x="@Format(tick.Position)" y="452">@tick.Label</text>
                </g>
            }

            <line class="chart-axis" x1="82" y1="430" x2="895" y2="430" />
            <line class="chart-axis" x1="82" y1="20" x2="82" y2="430" />
            @foreach (var bin in _bins)
            {
                <polygon class="density-bin" points="@bin.Points" fill="@bin.Fill" tabindex="0">
                    <title>@bin.Tooltip</title>
                </polygon>
            }

            <text class="chart-axis-label" x="488" y="488">Longitude</text>
            <text class="chart-axis-label" x="18" y="225" transform="rotate(-90 18 225)">Latitude</text>
        </svg>
    </div>
    <div class="density-legend">
        <span>Fewer</span><i style="background:#365c8d"></i><i style="background:#277f8e"></i><i style="background:#1fa187"></i><i style="background:#73d055"></i><i style="background:#fde725"></i><span>More observations</span>
        <small>Hover or focus a bin for its count and coordinates</small>
    </div>
</section>

@code {
    private const double Left = 82;
    private const double Right = 895;
    private const double Top = 20;
    private const double Bottom = 430;
    private readonly string _titleId = $"density-title-{Guid.NewGuid():N}";
    private readonly string _descriptionId = $"density-description-{Guid.NewGuid():N}";
    private IReadOnlyList<RenderedBin> _bins = [];
    private IReadOnlyList<AxisTick> _latitudeTicks = [];
    private IReadOnlyList<AxisTick> _longitudeTicks = [];

    [Parameter, EditorRequired] public PositionDensityDto Density { get; set; } = new();

    /// <summary>
    /// Rebuilds responsive SVG geometry whenever a recalculation supplies a new density model.
    /// </summary>
    protected override void OnParametersSet()
    {
        var longitudeRange = ExpandRange(Density.MinimumLongitude, Density.MaximumLongitude);
        var latitudeRange = ExpandRange(Density.MinimumLatitude, Density.MaximumLatitude);
        var radius = Math.Clamp((Right - Left) / 45d * 0.58d, 5d, 10d);

        // Convert geographic centres to fixed view-box coordinates while preserving the 45-cell hex grid.
        _bins = Density.Bins.Select(bin =>
        {
            var x = Scale(bin.Longitude, longitudeRange.Minimum, longitudeRange.Maximum, Left, Right);
            var y = Scale(bin.Latitude, latitudeRange.Minimum, latitudeRange.Maximum, Bottom, Top);
            return new RenderedBin
            {
                Points = HexagonPoints(x, y, radius),
                Fill = Viridis(bin.Count, Density.MaximumBinCount),
                Tooltip = $"{bin.Count:N0} observation{(bin.Count == 1 ? string.Empty : "s")} near {bin.Latitude:F5}, {bin.Longitude:F5}"
            };
        }).ToArray();
        _longitudeTicks = CreateTicks(longitudeRange.Minimum, longitudeRange.Maximum, Left, Right);
        _latitudeTicks = CreateTicks(latitudeRange.Minimum, latitudeRange.Maximum, Bottom, Top);
    }

    /// <summary>
    /// Expands a zero-width geographic domain and adds chart padding.
    /// </summary>
    /// <param name="minimum">Observed lower bound.</param>
    /// <param name="maximum">Observed upper bound.</param>
    /// <returns>Padded domain bounds.</returns>
    private static (double Minimum, double Maximum) ExpandRange(double minimum, double maximum)
    {
        var span = maximum - minimum;
        var padding = span > 0 ? span * 0.04d : 0.01d;
        return (minimum - padding, maximum + padding);
    }

    /// <summary>
    /// Maps a geographic value into an SVG coordinate range.
    /// </summary>
    /// <param name="value">The geographic value.</param>
    /// <param name="domainMinimum">Domain lower bound.</param>
    /// <param name="domainMaximum">Domain upper bound.</param>
    /// <param name="rangeMinimum">SVG range start.</param>
    /// <param name="rangeMaximum">SVG range end.</param>
    /// <returns>The corresponding SVG coordinate.</returns>
    private static double Scale(double value, double domainMinimum, double domainMaximum, double rangeMinimum, double rangeMaximum)
        => rangeMinimum + ((value - domainMinimum) / (domainMaximum - domainMinimum) * (rangeMaximum - rangeMinimum));

    /// <summary>
    /// Creates the six vertices of one pointy-topped density hexagon.
    /// </summary>
    /// <param name="x">Centre x coordinate.</param>
    /// <param name="y">Centre y coordinate.</param>
    /// <param name="radius">Hexagon radius.</param>
    /// <returns>An SVG polygon point list.</returns>
    private static string HexagonPoints(double x, double y, double radius)
    {
        // Pointy hexagons make adjacent staggered rows visually continuous.
        return string.Join(" ", Enumerable.Range(0, 6).Select(index =>
        {
            var angle = Math.PI / 180d * ((60d * index) - 30d);
            return $"{Format(x + radius * Math.Cos(angle))},{Format(y + radius * Math.Sin(angle))}";
        }));
    }

    /// <summary>
    /// Maps a bin count to a discrete approximation of the existing Viridis colour scale.
    /// </summary>
    /// <param name="count">Observation count in the bin.</param>
    /// <param name="maximum">Largest observation count in the plot.</param>
    /// <returns>A Viridis-compatible hexadecimal colour.</returns>
    private static string Viridis(int count, int maximum)
    {
        // Log scaling keeps low-density structure visible when a small number of bins dominate.
        var fraction = maximum <= 1 ? 1d : Math.Log(count + 1d) / Math.Log(maximum + 1d);
        if (fraction.CompareTo(0.2d) < 0)
        {
            return "#365c8d";
        }
        if (fraction.CompareTo(0.4d) < 0)
        {
            return "#277f8e";
        }
        if (fraction.CompareTo(0.6d) < 0)
        {
            return "#1fa187";
        }
        if (fraction.CompareTo(0.8d) < 0)
        {
            return "#73d055";
        }
        return "#fde725";
    }

    /// <summary>
    /// Creates five labelled geographic axis ticks.
    /// </summary>
    /// <param name="minimum">Domain minimum.</param>
    /// <param name="maximum">Domain maximum.</param>
    /// <param name="rangeStart">SVG range start.</param>
    /// <param name="rangeEnd">SVG range end.</param>
    /// <returns>Five evenly spaced ticks.</returns>
    private static IReadOnlyList<AxisTick> CreateTicks(double minimum, double maximum, double rangeStart, double rangeEnd)
        => Enumerable.Range(0, 5).Select(index =>
        {
            var fraction = index / 4d;
            return new AxisTick
            {
                Position = rangeStart + ((rangeEnd - rangeStart) * fraction),
                Label = (minimum + ((maximum - minimum) * fraction)).ToString("F3", CultureInfo.InvariantCulture)
            };
        }).ToArray();

    /// <summary>
    /// Formats an SVG number with culture-independent decimal punctuation.
    /// </summary>
    /// <param name="value">The number to format.</param>
    /// <returns>A compact SVG number.</returns>
    private static string Format(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private sealed class RenderedBin
    {
        public string Points { get; init; } = string.Empty;
        public string Fill { get; init; } = string.Empty;
        public string Tooltip { get; init; } = string.Empty;
    }

    private sealed class AxisTick
    {
        public double Position { get; init; }
        public string Label { get; init; } = string.Empty;
    }
}
